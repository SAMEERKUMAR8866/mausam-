---
import Layout from '../layouts/Layout.astro';
import GlobalNav from '../components/GlobalNav.astro';
import SubNav from '../components/SubNav.astro';
import FarmerDashboard from '../components/FarmerDashboard.astro';
---

<Layout 
  title="Farmer Dashboard - Mausam Precision Agriculture" 
  description="Personalized weather advisories, crop action plans, and agricultural risk warnings tailored for Indian farmers with real-time weather and AI agronomy insights."
>
  <!-- Nav header -->
  <GlobalNav />
  <SubNav />

  <main class="flex-1 bg-[#0B0F19]">
    
    <!-- Hero Banner for Dedicated Farmer Page -->
    <section class="relative w-full h-[220px] md:h-[280px] bg-[#0B0F19] overflow-hidden flex items-end">
      <!-- High-res agricultural scenery -->
      <div class="absolute inset-0 bg-cover bg-center transition-all duration-700 ease-in-out scale-102 opacity-60" style="background-image: url('https://images.unsplash.com/photo-1500937386664-56d1dfef3854?q=80&w=1200&auto=format&fit=crop'); background-color: #0B0F19;">
      </div>
      <!-- Soft dark visual gradient overlays -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F19] via-[#0B0F19]/70 to-transparent"></div>
      
      <!-- Hero Content Stack -->
      <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 pb-8 text-white">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs">
                🌾
              </span>
              <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Kisan Weather Intel</span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-apple-hero text-white leading-tight">
              Mausam Farmer Advisory
            </h1>
            <p class="text-sm sm:text-base text-slate-300 font-light tracking-apple-tight mt-1">
              Personalized crop cycle advisories powered by real-time micro-climate analysis
            </p>
          </div>

          <div class="flex items-center gap-3">
            <a href="/" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white text-xs font-medium border border-white/20 transition-all active-scale flex items-center gap-1.5 backdrop-blur-sm shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M19 12H5M12 19l-7-7 7-7"></path>
              </svg>
              <span>Back to All Dashboards</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Standalone Farmer Dashboard Container -->
    <section class="w-full bg-[#0B0F19] py-6">
      <FarmerDashboard isStandalone={true} defaultLocation="Greater Noida" />
    </section>

  </main>

  <!-- Apple-inspired Dark Glass Footer -->
  <footer class="bg-[#0F172A] border-t border-white/[0.08] text-slate-400 text-xs py-12 px-6" id="footer-section">
    <div class="max-w-[980px] mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-slate-400">
        <div>
          Copyright © 2026 Mausam Precision Agri • <span class="font-semibold text-white">SIH26076</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="/" class="hover:underline hover:text-emerald-400">Home</a>
          <span class="w-[1px] h-3 bg-white/15"></span>
          <a href="/farmer" class="hover:underline hover:text-emerald-400 font-semibold text-white">Farmer Portal</a>
          <span class="w-[1px] h-3 bg-white/15"></span>
          <a href="#" class="hover:underline hover:text-emerald-400">Agronomic Guidelines</a>
        </div>
      </div>
    </div>
  </footer>
</Layout>
