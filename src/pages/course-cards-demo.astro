---
import Layout from '../layouts/Layout.astro';
import DefaultDemo from '../components/ui/demo';
---

<Layout title="Course Design Cards Demo | Mausam">
  <main class="min-h-screen bg-[#151419] py-12 px-4 sm:px-6 lg:px-8 text-white">
    <div class="max-w-7xl mx-auto">
      <div class="mb-10 text-center">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
          Course Design Cards
        </h1>
        <p class="text-slate-400 max-w-2xl mx-auto text-base">
          Interactive progress cards featuring team avatars, countdown badges, and color-coded status accents.
        </p>
      </div>

      <div class="bg-[#1c1b22]/70 backdrop-blur-md rounded-2xl border border-white/10 p-4 sm:p-8 shadow-2xl">
        <DefaultDemo client:load />
      </div>
    </div>
  </main>
</Layout>
