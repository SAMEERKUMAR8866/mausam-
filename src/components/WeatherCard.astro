---
// src/components/WeatherCard.astro
// Aesthetic Glassmorphism Weather Metric Card

interface Props {
  id?: string;
  title: string;
  value: string | number;
  desc?: string;
  accentClass?: string;
}

const { id, title, value, desc, accentClass = "" } = Astro.props;
---
<div id={id} class="glass-card-interactive rounded-2xl p-6 flex flex-col justify-between min-h-[145px] border border-white/10 shadow-glass">
  <div>
    <!-- Card Heading -->
    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2.5 flex items-center justify-between">
      <span>{title}</span>
    </h3>
    
    <!-- Card Value -->
    <div class={`text-[28px] font-bold tracking-apple-tight text-white leading-none ${accentClass}`}>
      {value}
    </div>
  </div>
  
  <!-- Optional Description -->
  {desc && (
    <p class="text-xs text-slate-300 font-normal leading-relaxed mt-3 border-t border-white/10 pt-2.5">
      {desc}
    </p>
  )}
</div>
