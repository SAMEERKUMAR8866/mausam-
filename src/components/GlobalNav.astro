---
// src/components/GlobalNav.astro
// Global Top Navigation Bar with Adaptive Online/Offline Status & Modals Triggers
---

<nav class="sticky top-0 z-50 min-h-[44px] w-full bg-slate-950 text-[12px] font-normal tracking-[-0.01em] text-slate-100 flex items-center justify-between px-4 sm:px-6 border-b border-white/[0.08]" id="global-nav">
  <!-- Left Side: Brand Logo -->
  <div class="flex items-center gap-4 sm:gap-6">
    <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity active-scale">
      <!-- Minimalist SVG representing clouds and sun (Mausam logo) -->
      <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.5 19A3.5 3.5 0 0 0 21 15.5c0-2.79-2.54-4.5-5-4.5-.47 0-.89.09-1.3.27A5 5 0 0 0 5 14c0 2.76 2.24 5 5 5h7.5z" />
        <path d="M12 2v2M4.93 4.93l1.41 1.41M20 12h2M17.66 6.34l1.41-1.41" />
      </svg>
      <span class="font-bold text-white tracking-apple-tight text-sm uppercase">Mausam</span>
      <span id="nav-mode-badge" class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 transition-all">
        ONLINE
      </span>
    </a>
  </div>

  <!-- Center: Desktop Nav Links -->
  <div class="hidden md:flex items-center gap-6 text-slate-400 text-xs">
    <!-- Emergency SOS Hub Button in Nav -->
    <button type="button" id="nav-emergency-btn" class="sos-hub-trigger px-2.5 py-1 rounded-full bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-white border border-white/10 text-[11px] font-medium transition-all active-scale cursor-pointer flex items-center gap-1.5 shadow-sm" title="Disaster Response & Safety Hub">
      <span id="nav-emergency-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400/80"></span>
      <span id="nav-emergency-label">🛡️ SOS Hub (Standby)</span>
    </button>

    <button type="button" id="nav-radar-btn" class="hover:text-cyan-400 transition-colors cursor-pointer flex items-center gap-1">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span> Radar
    </button>
    <a href="#persona-dashboard-container" id="nav-profiles-link" class="hover:text-cyan-300 transition-colors">Profiles</a>
    <a href="/farmer" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
      <span>🌾</span> Agriculture Hub
    </a>
    <button type="button" id="nav-chat-btn" class="hover:text-violet-400 transition-colors cursor-pointer flex items-center gap-1">
      <span>✨</span> AI Copilot
    </button>
  </div>

  <!-- Right Side: Secondary Actions -->
  <div class="flex items-center gap-3">
    <!-- Install App CTA Button -->
    <button id="nav-install-btn" class="hidden lg:flex px-2.5 py-1 rounded-full bg-white/10 hover:bg-emerald-500 hover:text-slate-950 text-slate-200 text-[11px] font-semibold border border-white/10 hover:border-emerald-400 transition-all active-scale items-center gap-1 cursor-pointer" title="Install Mausam App">
      <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      <span>Install App</span>
    </button>

    <!-- Global Profile & Language Switcher Pill -->
    <button id="nav-profile-settings-btn" class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900/80 hover:bg-slate-800 border border-white/15 hover:border-emerald-400/40 text-slate-200 text-[11px] font-medium transition-all active-scale cursor-pointer shadow-sm" title="Change Profile or Language">
      <span id="nav-persona-icon" class="text-xs">🌾</span>
      <span id="nav-persona-name" class="hidden sm:inline font-semibold">Farmer</span>
      <span class="w-[1px] h-2.5 bg-white/20"></span>
      <span id="nav-lang-code" class="text-[10px] text-cyan-300 font-bold uppercase">EN</span>
      <svg class="w-2.5 h-2.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>

    <!-- Mini Saved Destinations button -->
    <button id="nav-saved-cities-btn" class="hover:text-white transition-colors active-scale p-1 cursor-pointer text-slate-400 hover:text-amber-400" aria-label="Saved Destinations" title="Saved Cities">
      <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16l7-4 7 4z"></path>
      </svg>
    </button>
  </div>
</nav>

<script>
  import { StorageService } from '../services/storage.service';
  import { PERSONAS } from '../data/personas';

  function updateNavElements() {
    const navModeBadge = document.getElementById('nav-mode-badge');
    const isOnline = navigator.onLine;

    if (navModeBadge) {
      if (isOnline) {
        navModeBadge.textContent = 'ONLINE';
        navModeBadge.className = 'px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 transition-all';
      } else {
        navModeBadge.textContent = 'OFFLINE';
        navModeBadge.className = 'px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-400/30 transition-all';
      }
    }

    const personaId = StorageService.getActivePersona();
    const lang = StorageService.getLanguage();
    const personaMeta = PERSONAS[personaId] || PERSONAS.farmer;

    const navPersonaIcon = document.getElementById('nav-persona-icon');
    const navPersonaName = document.getElementById('nav-persona-name');
    const navLangCode = document.getElementById('nav-lang-code');

    if (navPersonaIcon) navPersonaIcon.textContent = personaMeta.icon;
    if (navPersonaName) navPersonaName.textContent = personaMeta.name.split('/')[0].trim();
    if (navLangCode) navLangCode.textContent = lang.toUpperCase();
  }

  // Network listeners
  window.addEventListener('online', updateNavElements);
  window.addEventListener('offline', updateNavElements);
  window.addEventListener('mausam-persona-changed', updateNavElements);
  window.addEventListener('mausam-language-changed', updateNavElements);

  // Trigger buttons
  document.getElementById('nav-radar-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-radar'));
  });

  document.getElementById('nav-chat-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-chatbot'));
  });

  document.getElementById('nav-saved-cities-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-saved-locations'));
  });

  document.getElementById('nav-profile-settings-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-profile-settings'));
  });

  document.querySelectorAll('.sos-hub-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('mausam-open-sos-hub'));
    });
  });

  // Init
  updateNavElements();
</script>
