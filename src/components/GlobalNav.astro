---
// src/components/GlobalNav.astro
---
<nav class="sticky top-0 z-50 h-11 w-full bg-surface-black text-[12px] font-normal tracking-[-0.01em] text-body-on-dark flex items-center justify-between px-6 border-b border-white/[0.08]" id="global-nav">
  <!-- Left Side: Brand Logo -->
  <div class="flex items-center gap-6">
    <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity active-scale">
      <!-- Minimalist SVG representing clouds and sun (Mausam logo) -->
      <svg class="w-4.5 h-4.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.5 19A3.5 3.5 0 0 0 21 15.5c0-2.79-2.54-4.5-5-4.5-.47 0-.89.09-1.3.27A5 5 0 0 0 5 14c0 2.76 2.24 5 5 5h7.5z" />
        <path d="M12 2v2M4.93 4.93l1.41 1.41M20 12h2M17.66 6.34l1.41-1.41" />
      </svg>
      <span class="font-semibold text-white tracking-apple-tight text-sm uppercase">Mausam</span>
    </a>
  </div>

  <!-- Center: Desktop Nav Links -->
  <div class="hidden md:flex items-center gap-6 text-ink-muted-48">
    <a href="#" class="text-white hover:text-primary-on-dark transition-colors">Radar</a>
    <a href="#" class="hover:text-primary-on-dark transition-colors">Forecasts</a>
    <a href="#" class="hover:text-primary-on-dark transition-colors">Air Quality</a>
    <a href="#" class="hover:text-primary-on-dark transition-colors">Climate</a>
    <a href="/farmer" class="hover:text-primary-on-dark transition-colors">Agriculture</a>
    <a href="#" class="hover:text-primary-on-dark transition-colors">Alerts</a>
  </div>

  <!-- Right Side: Secondary Actions -->
  <div class="flex items-center gap-4">
    <!-- Mini Search Button -->
    <button class="hover:text-white transition-colors active-scale p-1 cursor-pointer" aria-label="Search">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
    <!-- Mini Profile/Saved Destinations button -->
    <button class="hover:text-white transition-colors active-scale p-1 cursor-pointer" aria-label="Saved Destinations">
      <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16l7-4 7 4z"></path>
      </svg>
    </button>
  </div>
</nav>
