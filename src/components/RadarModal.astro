---
// src/components/RadarModal.astro
// Live Meteorological Radar & Doppler Rain Map Modal
---

<div id="radar-modal" class="hidden fixed inset-0 z-50 overflow-hidden bg-slate-950/85 backdrop-blur-xl p-4 sm:p-6 flex items-center justify-center">
  <div class="w-full max-w-4xl bg-slate-900 border border-white/15 rounded-3xl p-5 sm:p-6 shadow-2xl relative overflow-hidden flex flex-col max-h-[90vh]">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4 shrink-0">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 flex items-center justify-center text-lg">
          🛰️
        </div>
        <div>
          <h3 class="text-base font-bold text-white tracking-apple-tight">Live Meteorological Radar</h3>
          <p class="text-xs text-slate-400 font-light">Doppler precipitation radar nowcasting & cloud reflectivity</p>
        </div>
      </div>
      <button id="close-radar-modal-btn" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-all cursor-pointer">
        ✕
      </button>
    </div>

    <!-- Embedded Interactive Radar Frame / RainViewer map -->
    <div class="flex-1 min-h-[380px] bg-slate-950 rounded-2xl overflow-hidden border border-white/10 relative">
      <iframe
        id="radar-iframe"
        src="https://www.rainviewer.com/map.html?loc=28.6139,77.2090,7&oFa=0&oC=1&oU=0&oCS=1&oF=0&oAP=1&c=3&o=83&lm=1&layer=radar&sm=1&sn=1"
        class="w-full h-full border-0"
        title="Live Doppler Weather Radar"
        loading="lazy"
      ></iframe>
    </div>

    <!-- Radar Legend Footer -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 mt-2 border-t border-white/10 text-xs text-slate-400 shrink-0">
      <div class="flex items-center gap-2">
        <span>Intensity:</span>
        <div class="flex items-center gap-1">
          <span class="w-3 h-3 rounded-full bg-blue-400" title="Light Drizzle"></span>
          <span class="text-[10px]">Light</span>
          <span class="w-3 h-3 rounded-full bg-green-400" title="Moderate"></span>
          <span class="text-[10px]">Moderate</span>
          <span class="w-3 h-3 rounded-full bg-amber-400" title="Heavy"></span>
          <span class="text-[10px]">Heavy</span>
          <span class="w-3 h-3 rounded-full bg-red-500" title="Severe Hail/Storm"></span>
          <span class="text-[10px]">Severe</span>
        </div>
      </div>
      <span class="text-[11px] text-slate-500">Source: Open-Meteo & RainViewer Global Composite</span>
    </div>

  </div>
</div>

<script>
  const radarModal = document.getElementById('radar-modal');
  const closeRadarBtn = document.getElementById('close-radar-modal-btn');

  closeRadarBtn?.addEventListener('click', () => {
    radarModal?.classList.add('hidden');
  });

  window.addEventListener('mausam-open-radar', () => {
    radarModal?.classList.remove('hidden');
  });
</script>
