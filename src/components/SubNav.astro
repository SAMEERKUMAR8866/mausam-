---
// src/components/SubNav.astro
// Glassmorphism Sub-Navigation Bar with Location Search, Persona Pill, & Quick Tools
---

<div class="sticky top-11 z-40 min-h-12 w-full bg-slate-950/90 backdrop-blur-xl border-b border-white/10 shadow-glass" id="sub-nav-frosted">
  <div class="flex items-center justify-between gap-2 w-full px-3 sm:px-6 py-2 overflow-visible relative">
    
    <!-- Left Side: Dashboard Title & Active Persona Badge Container -->
    <div class="flex items-center gap-2 shrink-0 min-w-0">
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="text-emerald-400 text-sm sm:text-base shrink-0">✦</span>
        <span id="sub-nav-title" class="text-base sm:text-lg font-bold tracking-apple-tight text-white whitespace-nowrap shrink-0">Dashboard</span>
      </div>

      <!-- Active Persona Switcher Pill -->
      <div class="shrink-0">
        <button id="sub-nav-persona-pill" type="button" class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-semibold transition-all active-scale cursor-pointer shrink-0" title="Click to switch persona or language">
          <span id="sub-nav-persona-icon">🌾</span>
          <span id="sub-nav-persona-name" class="max-w-[75px] sm:max-w-[110px] truncate">Farmer</span>
          <span class="text-[10px] text-emerald-400/70">▾</span>
        </button>
      </div>

      <span class="h-4 w-[1px] bg-white/15 hidden md:block shrink-0"></span>

      <!-- Location Display Text -->
      <button id="sub-nav-city-display" class="text-xs sm:text-sm font-medium text-slate-300 hover:text-white hidden md:flex items-center gap-1.5 px-2 py-1 rounded-lg hover:bg-white/5 transition-all cursor-pointer shrink-0 truncate max-w-[200px]" title="Click to view all saved cities">
        <span id="sub-nav-city-dot" class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse shrink-0"></span>
        <span id="sub-nav-city-name" class="truncate">New Delhi, Delhi, India</span>
        <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
    </div>

    <!-- Right Side: Location Input Container & Secondary Actions -->
    <div class="flex items-center gap-1.5 sm:gap-2 flex-1 min-w-0 max-w-[260px] sm:max-w-[420px] justify-end relative">
      
      <!-- Location Search Pill Container -->
      <div class="relative flex-1 min-w-0 max-w-[180px] sm:max-w-[240px]" id="location-search-container" style="overflow: visible;">
        <button id="location-search-btn" type="button" class="absolute left-2.5 top-1/2 -translate-y-1/2 text-cyan-400 hover:text-emerald-300 transition-colors cursor-pointer text-xs p-0.5 z-10 shrink-0" title="Search location">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </button>
        <input
          type="text"
          id="location-search-input"
          placeholder="New Delhi, Delhi, India"
          autocomplete="off"
          class="h-8 sm:h-9 pl-8 pr-3 glass-input rounded-full text-xs font-medium tracking-apple-tight w-full truncate transition-all duration-200 focus:ring-1 focus:ring-emerald-400"
        />
        <!-- Search Results Dropdown -->
        <div id="location-search-results" class="absolute right-0 top-full mt-2 rounded-2xl shadow-2xl hidden max-h-[380px] overflow-y-auto z-[9999] border border-white/20 divide-y divide-white/10" style="min-width: 280px; background: rgba(8, 14, 28, 0.98); backdrop-filter: blur(24px);"></div>
      </div>

      <!-- Use My Current Location (GPS) Button -->
      <button id="use-my-location-btn" class="p-1.5 sm:px-2.5 sm:py-1.5 bg-slate-900/80 hover:bg-slate-800 text-slate-200 hover:text-emerald-300 text-xs font-medium border border-white/10 rounded-full transition-all active-scale cursor-pointer flex items-center gap-1 shadow-sm shrink-0" title="Use my current location">
        <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 2v4m0 12v4M2 12h4m12 0h4"></path>
        </svg>
        <span id="use-my-location-text" class="hidden sm:inline font-semibold">GPS</span>
      </button>

      <!-- Emergency SOS Hub Button -->
      <button id="sub-nav-emergency-btn" class="sos-hub-trigger p-1.5 sm:px-2.5 sm:py-1.5 bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-white text-xs font-medium rounded-full border border-white/10 transition-all active-scale cursor-pointer shadow-sm flex items-center gap-1 shrink-0" title="Safety & Disaster Response Hub">
        <span id="sub-nav-emergency-icon">🛡️</span>
        <span id="sub-nav-emergency-text" class="hidden lg:inline">SOS Hub (Standby)</span>
      </button>

      <!-- Live Radar Pill Button -->
      <button id="sub-nav-radar-btn" class="hidden sm:flex px-3.5 py-1.5 bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 text-xs font-bold rounded-full transition-all active-scale cursor-pointer shadow-glow-emerald items-center gap-1 shrink-0">
        <span>🛰️</span>
        <span>Radar</span>
      </button>

    </div>

  </div>
</div>

<script>
  import { StorageService } from '../services/storage.service';
  import { searchLocations, detectUserLocation } from '../services/geocoding.service';
  import { PERSONAS } from '../data/personas';

  const subNavPersonaPill = document.getElementById('sub-nav-persona-pill');
  const subNavPersonaIcon = document.getElementById('sub-nav-persona-icon');
  const subNavPersonaName = document.getElementById('sub-nav-persona-name');
  const subNavCityDisplay = document.getElementById('sub-nav-city-display');
  const subNavCityName = document.getElementById('sub-nav-city-name');
  const locationSearchInput = document.getElementById('location-search-input') as HTMLInputElement | null;
  const locationSearchResults = document.getElementById('location-search-results');
  const useMyLocationBtn = document.getElementById('use-my-location-btn');
  const subNavRadarBtn = document.getElementById('sub-nav-radar-btn');

  function updateSubNavPersona() {
    const personaId = StorageService.getActivePersona();
    const meta = PERSONAS[personaId] || PERSONAS.farmer;
    if (subNavPersonaIcon) subNavPersonaIcon.textContent = meta.icon;
    if (subNavPersonaName) subNavPersonaName.textContent = meta.name.split('/')[0].trim();
  }

  function updateSubNavLocation(display: string) {
    if (subNavCityName) subNavCityName.textContent = display;
    if (locationSearchInput) locationSearchInput.placeholder = display;
  }

  // Bind persona pill click
  subNavPersonaPill?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-profile-settings'));
  });

  subNavCityDisplay?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-saved-locations'));
  });

  subNavRadarBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-radar'));
  });

  // Autocomplete search
  let searchDebounce: any;
  locationSearchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.trim();
    clearTimeout(searchDebounce);
    if (!query) {
      if (locationSearchResults) locationSearchResults.classList.add('hidden');
      return;
    }
    searchDebounce = setTimeout(async () => {
      try {
        const results = await searchLocations(query);
        if (!locationSearchResults) return;
        if (!results || results.length === 0) {
          locationSearchResults.innerHTML = `<div class="p-3 text-xs text-slate-400 text-center">No locations found</div>`;
          locationSearchResults.classList.remove('hidden');
          return;
        }
        locationSearchResults.innerHTML = results.map(loc => `
          <button type="button" class="search-result-item w-full px-3.5 py-2.5 text-left text-xs hover:bg-white/10 transition-colors flex items-center justify-between cursor-pointer border-b border-white/5 last:border-0" data-loc-key="${loc.key}" data-loc-display="${loc.display}">
            <div class="truncate mr-2">
              <span class="font-semibold text-white">${loc.name}</span>
              <span class="text-slate-400 text-[11px] block truncate">${loc.region ? `${loc.region}, ` : ''}${loc.country}</span>
            </div>
            <span class="text-cyan-400 text-[10px] shrink-0 font-medium">Select ➔</span>
          </button>
        `).join('');
        locationSearchResults.classList.remove('hidden');

        locationSearchResults.querySelectorAll('.search-result-item').forEach(item => {
          item.addEventListener('click', () => {
            const key = item.getAttribute('data-loc-key') || '';
            const display = item.getAttribute('data-loc-display') || '';
            locationSearchResults.classList.add('hidden');
            if (locationSearchInput) locationSearchInput.value = '';
            StorageService.setLastLocation(display, key);
            StorageService.addSavedLocation(display);
            updateSubNavLocation(display);
            window.dispatchEvent(new CustomEvent('mausam-location-selected', { detail: { key, display } }));
          });
        });
      } catch (err) {
        console.warn('[SubNav] Search error:', err);
      }
    }, 250);
  });

  // Close search dropdown on outside click
  document.addEventListener('click', (e) => {
    if (!locationSearchInput?.contains(e.target as Node) && !locationSearchResults?.contains(e.target as Node)) {
      locationSearchResults?.classList.add('hidden');
    }
  });

  // GPS Current Location Click
  useMyLocationBtn?.addEventListener('click', async () => {
    try {
      useMyLocationBtn.classList.add('opacity-60');
      const loc = await detectUserLocation();
      StorageService.setLastLocation(loc.display, loc.key);
      StorageService.addSavedLocation(loc.display);
      updateSubNavLocation(loc.display);
      window.dispatchEvent(new CustomEvent('mausam-location-selected', { detail: { key: loc.key, display: loc.display } }));
    } catch (err) {
      alert('Unable to retrieve your GPS location.');
    } finally {
      useMyLocationBtn.classList.remove('opacity-60');
    }
  });

  // Listeners
  window.addEventListener('mausam-persona-changed', updateSubNavPersona);
  window.addEventListener('mausam-location-changed', (e: any) => {
    if (e.detail?.display) updateSubNavLocation(e.detail.display);
  });

  // Init
  updateSubNavPersona();
  const initialLoc = StorageService.getLastLocation();
  if (initialLoc) updateSubNavLocation(initialLoc);
</script>
