---
// src/components/SubNav.astro
// Sub-Navigation Bar with Single-Row Compact Layout, Inline Location Search Pill, Persona Switcher & Tools
---

<div class="sticky top-[44px] z-[55] w-full bg-[#0B0F19]/95 backdrop-blur-xl border-b border-white/[0.08] shadow-glass transition-all" id="sub-nav-frosted">
  <div class="max-w-[1440px] mx-auto px-3 sm:px-6 py-2 flex items-center justify-between gap-2 sm:gap-3">
    
    <!-- Left Section: Dashboard Title & Persona Pill -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <div class="flex items-center gap-1.5">
        <span class="text-emerald-400 text-sm sm:text-base shrink-0">✦</span>
        <span id="sub-nav-title" data-i18n="dashboard" class="text-sm sm:text-base font-bold tracking-apple-tight text-white whitespace-nowrap">Dashboard</span>
      </div>

      <!-- Active Persona Switcher Pill -->
      <button id="sub-nav-persona-pill" type="button" class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-400/30 text-emerald-300 text-xs font-semibold transition-all active-scale cursor-pointer shrink-0" title="Click to switch persona or language">
        <span id="sub-nav-persona-icon">🌾</span>
        <span id="sub-nav-persona-name" class="max-w-[75px] sm:max-w-[110px] truncate">Farmer</span>
        <span class="text-[10px] text-emerald-400/80">▾</span>
      </button>
    </div>

    <!-- Right Section: Inline Location Search Pill, GPS Button, SOS & Radar -->
    <div class="flex items-center gap-1.5 sm:gap-2 flex-1 justify-end max-w-md sm:max-w-xl">
      
      <!-- Inline Location Search Pill -->
      <div class="relative flex-1 min-w-[95px] max-w-[150px] sm:max-w-[260px] md:max-w-[320px] z-[60]" id="location-search-container">
        <!-- Location Pin Icon -->
        <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-cyan-400 text-xs pointer-events-none shrink-0 z-10">📍</span>
        
        <!-- Search Input -->
        <input
          type="text"
          id="location-search-input"
          placeholder="Search location..."
          data-i18n-placeholder="searchPlaceholder"
          autocomplete="off"
          class="w-full h-8 sm:h-9 pl-7 sm:pl-8 pr-3 rounded-full bg-[#1E293B]/90 hover:bg-[#1E293B] text-slate-100 placeholder-cyan-300/70 text-xs font-medium border border-white/[0.08] focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400/30 focus:outline-none truncate transition-all shadow-inner"
        />

        <!-- Autocomplete Dropdown Menu -->
        <div
          id="location-search-results"
          class="absolute right-0 top-full mt-2 w-[290px] sm:w-[350px] md:max-w-[390px] rounded-2xl shadow-[0_25px_70px_rgba(0,0,0,0.95)] hidden max-h-[380px] overflow-y-auto z-[99999] border border-white/[0.08] divide-y divide-white/[0.06] backdrop-blur-2xl bg-[#0B0F19]/98"
        ></div>
      </div>

      <!-- GPS Target Button (Round icon button) -->
      <button
        type="button"
        id="use-my-location-btn"
        class="w-8 h-8 rounded-full bg-[#1E293B]/80 hover:bg-[#1E293B] border border-white/[0.08] text-cyan-400 hover:text-emerald-300 flex items-center justify-center transition-all active-scale cursor-pointer shrink-0 shadow-sm"
        title="Detect location via GPS"
      >
        <svg class="w-4 h-4 text-cyan-400 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="7"></circle>
          <circle cx="12" cy="12" r="2"></circle>
          <line x1="12" y1="2" x2="12" y2="5"></line>
          <line x1="12" y1="19" x2="12" y2="22"></line>
          <line x1="2" y1="12" x2="5" y2="12"></line>
          <line x1="19" y1="12" x2="22" y2="12"></line>
        </svg>
      </button>

      <!-- SOS Hub Button (Round icon button) -->
      <button
        type="button"
        id="sub-nav-emergency-btn"
        class="sos-hub-trigger w-8 h-8 rounded-full bg-[#1E293B]/80 hover:bg-[#1E293B] border border-white/[0.08] text-slate-300 hover:text-white flex items-center justify-center transition-all active-scale cursor-pointer shrink-0 shadow-sm"
        title="Disaster & Safety SOS Hub"
      >
        <span class="text-xs">🛡️</span>
      </button>

      <!-- Desktop-only Radar Pill -->
      <button
        type="button"
        id="sub-nav-radar-btn"
        class="hidden sm:flex px-3 py-1.5 bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 text-xs font-bold rounded-full transition-all active-scale cursor-pointer shadow-glow-emerald items-center gap-1 shrink-0"
      >
        <span>🛰️</span>
        <span data-i18n="radar">Radar</span>
      </button>

    </div>

  </div>
</div>

<script>
  import { StorageService } from '../services/storage.service';
  import { I18nService } from '../services/i18n.service';
  import { NetworkService } from '../services/network.service';
  import { searchLocationsAsync, searchLocations, detectUserLocation, MOCK_LOCATIONS, saveSearchedLocation } from '../services/geocoding.service';
  import { PERSONAS } from '../data/personas';

  const subNavFrosted = document.getElementById('sub-nav-frosted');
  const subNavPersonaPill = document.getElementById('sub-nav-persona-pill');
  const subNavPersonaIcon = document.getElementById('sub-nav-persona-icon');
  const subNavPersonaName = document.getElementById('sub-nav-persona-name');
  const locationSearchInput = document.getElementById('location-search-input') as HTMLInputElement | null;
  const locationSearchResults = document.getElementById('location-search-results');
  const useMyLocationBtn = document.getElementById('use-my-location-btn');
  const subNavRadarBtn = document.getElementById('sub-nav-radar-btn');

  function updateSubNavPersona() {
    const personaId = StorageService.getActivePersona();
    const meta = PERSONAS[personaId] || PERSONAS.farmer;
    const rawName = meta.name.split('/')[0].trim();
    if (subNavPersonaIcon) subNavPersonaIcon.textContent = meta.icon;
    if (subNavPersonaName) subNavPersonaName.textContent = I18nService.t(rawName, rawName);
  }

  function updateSubNavLocation(display: string) {
    if (locationSearchInput) {
      const shortName = display.split(',')[0].trim();
      const isOnline = NetworkService.isOnline();
      locationSearchInput.placeholder = isOnline ? shortName : `${shortName} (Offline)`;
    }
  }

  function showSearchDropdown() {
    if (!locationSearchResults) return;
    subNavFrosted?.classList.add('z-[100]');
    locationSearchResults.classList.remove('hidden');
  }

  function hideSearchDropdown() {
    if (!locationSearchResults) return;
    subNavFrosted?.classList.remove('z-[100]');
    locationSearchResults.classList.add('hidden');
  }

  // Bind persona pill click
  subNavPersonaPill?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-profile-settings'));
  });

  subNavRadarBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-radar'));
  });

  function renderSearchResults(locations: any[]) {
    if (!locationSearchResults) return;
    const isOnline = NetworkService.isOnline();

    if (!locations || locations.length === 0) {
      locationSearchResults.innerHTML = `
        <div class="p-3 text-xs text-slate-400 text-center">
          <span>🔍 ${I18nService.t('No matching locations found', 'No matching locations found')}</span>
        </div>
      `;
      showSearchDropdown();
      return;
    }

    const headerTitle = isOnline ? I18nService.t('Select Location', 'Select Location') : I18nService.t('Offline Location Database', 'Offline Location Database');

    locationSearchResults.innerHTML = `
      <div class="px-3 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider bg-slate-900/60 border-b border-white/5 flex items-center justify-between">
        <span>${headerTitle}</span>
        ${!isOnline ? '<span class="text-amber-400 text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-500/10 border border-amber-400/20">OFFLINE READY</span>' : ''}
      </div>
      ${locations.map(loc => {
        const isFallback = loc.isFallback || loc.matchType === 'fallback';
        const isFuzzy = loc.matchType === 'fuzzy';
        return `
        <button
          type="button"
          class="search-result-item w-full px-3.5 py-2.5 text-left text-xs hover:bg-emerald-500/10 active:bg-emerald-500/20 transition-colors flex items-center justify-between cursor-pointer border-b border-white/5 last:border-0 ${isFallback ? 'bg-amber-500/5' : ''}"
          data-loc-key="${loc.id || loc.key || loc.name.toLowerCase().replace(/\s+/g, '_')}"
          data-loc-display="${loc.display || `${loc.name}, ${loc.region ? `${loc.region}, ` : ''}${loc.country}`}"
          data-loc-lat="${loc.lat}"
          data-loc-lon="${loc.lon}"
          data-loc-name="${loc.name}"
          data-loc-region="${loc.region || ''}"
          data-loc-country="${loc.country || 'India'}"
        >
          <div class="truncate mr-2 flex items-center gap-2">
            <span class="text-emerald-400 text-sm shrink-0">📍</span>
            <div class="truncate">
              <div class="flex items-center gap-1.5 truncate">
                <span class="font-semibold text-white truncate">${loc.name}</span>
                ${loc.category ? `<span class="text-[9px] px-1.5 py-0.2 rounded bg-white/5 border border-white/10 text-slate-400">${loc.category}</span>` : ''}
                ${isFallback ? `<span class="text-[9px] px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 font-bold border border-amber-400/30">Suggested</span>` : ''}
                ${isFuzzy ? `<span class="text-[9px] px-1.5 py-0.2 rounded bg-cyan-500/20 text-cyan-300 font-bold border border-cyan-400/30">Did you mean?</span>` : ''}
              </div>
              <span class="text-slate-400 text-[11px] block truncate mt-0.5">
                ${loc.suggestionReason ? `<span class="text-cyan-400/90 font-medium">${loc.suggestionReason} • </span>` : ''}
                ${loc.region ? `${loc.region}, ` : ''}${loc.country || 'India'}
              </span>
            </div>
          </div>
          <span class="text-cyan-400 text-[10px] shrink-0 font-medium px-2 py-0.5 rounded bg-cyan-950/40 border border-cyan-500/20">Select ➔</span>
        </button>
      `}).join('')}
    `;
    showSearchDropdown();

    locationSearchResults.querySelectorAll('.search-result-item').forEach(item => {
      item.addEventListener('click', () => {
        const key = item.getAttribute('data-loc-key') || '';
        const display = item.getAttribute('data-loc-display') || '';
        const lat = parseFloat(item.getAttribute('data-loc-lat') || '0');
        const lon = parseFloat(item.getAttribute('data-loc-lon') || '0');
        const name = item.getAttribute('data-loc-name') || '';
        const region = item.getAttribute('data-loc-region') || '';
        const country = item.getAttribute('data-loc-country') || 'India';

        if (name) {
          saveSearchedLocation({ id: key, name, region, country, lat, lon, display });
        }

        hideSearchDropdown();
        if (locationSearchInput) {
          locationSearchInput.value = '';
          const shortName = display.split(',')[0].trim();
          locationSearchInput.placeholder = shortName;
        }
        StorageService.setLastLocation(display, key);
        StorageService.addSavedLocation(display);
        updateSubNavLocation(display);
        window.dispatchEvent(new CustomEvent('mausam-location-selected', { detail: { key, display, lat, lon } }));
        window.dispatchEvent(new CustomEvent('mausam-location-changed', { detail: { key, display, lat, lon } }));
      });
    });
  }

  // Show popular/saved locations when clicking on empty input
  locationSearchInput?.addEventListener('focus', () => {
    if (!locationSearchInput.value.trim()) {
      const isOnline = NetworkService.isOnline();
      if (!isOnline) {
        // Show saved cities first when offline
        const saved = StorageService.getSavedLocations();
        const savedObjs = saved.map(s => {
          const parts = s.split(',');
          return {
            id: parts[0].trim().toLowerCase().replace(/\s+/g, '_'),
            name: parts[0].trim(),
            region: parts[1]?.trim() || '',
            country: parts[2]?.trim() || 'India',
            lat: 28.61,
            lon: 77.20,
            display: s
          };
        });
        renderSearchResults(savedObjs.length > 0 ? savedObjs : MOCK_LOCATIONS.slice(0, 6));
      } else {
        const topLocations = MOCK_LOCATIONS.slice(0, 8);
        renderSearchResults(topLocations);
      }
    }
  });

  // Autocomplete search
  let searchDebounce: any;
  locationSearchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.trim();
    clearTimeout(searchDebounce);
    if (!query) {
      const topLocations = MOCK_LOCATIONS.slice(0, 8);
      renderSearchResults(topLocations);
      return;
    }
    searchDebounce = setTimeout(async () => {
      const isOnline = NetworkService.isOnline();
      if (!isOnline) {
        // Search local mock & saved list only
        renderSearchResults(searchLocations(query));
      } else {
        try {
          const results = await searchLocationsAsync(query);
          renderSearchResults(results && results.length > 0 ? results : searchLocations(query));
        } catch (err) {
          console.warn('[SubNav] Search error:', err);
          renderSearchResults(searchLocations(query));
        }
      }
    }, 200);
  });

  // Close search dropdown on outside click
  document.addEventListener('click', (e) => {
    if (!locationSearchInput?.contains(e.target as Node) && !locationSearchResults?.contains(e.target as Node)) {
      hideSearchDropdown();
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      hideSearchDropdown();
    }
  });

  // GPS Current Location Click
  useMyLocationBtn?.addEventListener('click', async () => {
    try {
      useMyLocationBtn.classList.add('opacity-60');
      const loc = await detectUserLocation();
      StorageService.setLastLocation(loc.display, loc.key);
      StorageService.addSavedLocation(loc.display);
      updateSubNavLocation(loc.display);
      window.dispatchEvent(new CustomEvent('mausam-location-selected', { detail: { key: loc.key, display: loc.display } }));
      window.dispatchEvent(new CustomEvent('mausam-location-changed', { detail: { key: loc.key, display: loc.display } }));
    } catch (err) {
      alert('Unable to retrieve GPS location.');
    } finally {
      useMyLocationBtn.classList.remove('opacity-60');
    }
  });

  function updateSubNavTranslations() {
    const root = document.getElementById('sub-nav-frosted');
    if (root) I18nService.translateDocument(root);
  }

  // Listeners
  window.addEventListener('mausam-persona-changed', updateSubNavPersona);
  window.addEventListener('mausam-language-changed', () => {
    updateSubNavTranslations();
    updateSubNavPersona();
  });
  window.addEventListener('mausam-location-changed', (e: any) => {
    if (e.detail?.display) updateSubNavLocation(e.detail.display);
  });
  window.addEventListener('mausam-location-selected', (e: any) => {
    if (e.detail?.display) updateSubNavLocation(e.detail.display);
  });
  window.addEventListener('mausam-network-status-changed', () => {
    const initialLoc = StorageService.getLastLocation();
    if (initialLoc) updateSubNavLocation(initialLoc);
  });

  // Init
  updateSubNavPersona();
  updateSubNavTranslations();
  const initialLoc = StorageService.getLastLocation();
  if (initialLoc) updateSubNavLocation(initialLoc);
</script>

