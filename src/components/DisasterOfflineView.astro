---
// src/components/DisasterOfflineView.astro
// Unified Meteorological Emergency & Disaster Protocol View (Red / Orange / Yellow Alert Tiers)
---

<div id="disaster-offline-view-container" class="hidden w-full max-w-[1440px] mx-auto px-4 sm:px-6 pt-4 pb-2 transition-all duration-300">
  <div id="disaster-card-wrapper" class="rounded-3xl bg-gradient-to-b from-red-950/90 via-[#0F172A]/90 to-[#0B0F19]/95 border-2 border-red-500/60 p-5 sm:p-7 shadow-[0_0_60px_rgba(239,68,68,0.3)] relative overflow-hidden transition-all">
    
    <!-- Top Glowing Warning Line -->
    <div id="disaster-accent-bar" class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-red-600 via-rose-500 to-amber-500 animate-pulse"></div>

    <!-- Top Warning Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-white/[0.08] mb-5">
      <div class="flex items-start sm:items-center gap-3.5">
        <div id="disaster-view-icon-box" class="w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-red-600/30 border border-red-500/60 text-3xl flex items-center justify-center animate-bounce shadow-[0_0_25px_rgba(239,68,68,0.5)] shrink-0">
          🚨
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span id="disaster-view-badge" class="text-[10px] font-black uppercase tracking-widest px-2.5 py-0.5 rounded bg-red-600 text-white animate-pulse">
              CRITICAL RED ALERT
            </span>
            <span id="disaster-view-source-badge" class="text-[10px] font-semibold text-slate-300 bg-[#0B0F19]/80 px-2 py-0.5 rounded border border-white/[0.08]">
              IMD Calibrated
            </span>
          </div>
          <h3 id="disaster-view-hazard-title" class="text-base sm:text-xl font-extrabold text-white tracking-apple-tight">
            Severe Weather Alert
          </h3>
          <p id="disaster-view-hazard-desc" class="text-xs sm:text-sm text-red-200/90 mt-1 max-w-3xl leading-relaxed">
            Immediate emergency protocols initiated based on atmospheric threshold violations.
          </p>
        </div>
      </div>

      <!-- Quick Action Buttons Group -->
      <div class="flex flex-wrap items-center gap-2.5 shrink-0 self-start lg:self-center">
        <a href="tel:112" id="disaster-call-112-btn" class="px-4 py-2 rounded-full bg-red-700/80 hover:bg-red-600 border border-red-400/40 text-white font-bold text-xs uppercase tracking-wider shadow-lg transition-all active-scale flex items-center gap-1.5">
          <span>📞</span> <span>112 SOS</span>
        </a>
        <button type="button" id="btn-disaster-open-sos" class="px-5 py-2 rounded-full bg-red-600 hover:bg-red-500 text-white font-black text-xs uppercase tracking-wider shadow-lg transition-all active-scale cursor-pointer flex items-center gap-2">
          <span>🛡️</span> <span>Open SOS Hub</span>
        </button>
      </div>
    </div>

    <!-- Disaster Trigger Reasons & Active Protocols Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      <!-- Detection Triggers -->
      <div class="p-4 rounded-2xl bg-[#1E293B]/80 border border-white/[0.08] flex flex-col justify-between">
        <div>
          <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2.5 flex items-center gap-1.5">
            <span class="text-amber-400">⚠️</span> Threshold Violation Triggers
          </h4>
          <ul id="disaster-triggers-list" class="space-y-2 text-xs text-red-300 font-medium"></ul>
        </div>
        <div class="mt-3 pt-2.5 border-t border-white/[0.08] flex items-center justify-between text-[11px] text-slate-400">
          <span>Rule Engine: Meteorological Standards</span>
          <span id="disaster-timestamp" class="text-slate-300 font-mono">Live</span>
        </div>
      </div>

      <!-- Actionable Safety Protocols -->
      <div class="p-4 rounded-2xl bg-[#1E293B]/80 border border-white/[0.08] flex flex-col justify-between">
        <div>
          <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2.5 flex items-center gap-1.5">
            <span class="text-emerald-400">✅</span> Actionable Safety & Defense Protocols
          </h4>
          <ul id="disaster-protocols-list" class="space-y-2 text-xs text-slate-200"></ul>
        </div>
        <div class="mt-3 pt-2.5 border-t border-white/[0.08] flex items-center justify-between text-[11px] text-slate-400">
          <span>Zero-Cellular BLE Relay Active</span>
          <button type="button" id="disaster-view-manual-btn" class="text-cyan-400 hover:underline cursor-pointer">
            View Survival Manuals ↗
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  import { I18nService } from '../services/i18n.service';

  const container = document.getElementById('disaster-offline-view-container');
  const cardWrapper = document.getElementById('disaster-card-wrapper');
  const accentBar = document.getElementById('disaster-accent-bar');
  const iconBox = document.getElementById('disaster-view-icon-box');
  const badge = document.getElementById('disaster-view-badge');
  const title = document.getElementById('disaster-view-hazard-title');
  const desc = document.getElementById('disaster-view-hazard-desc');
  const triggersList = document.getElementById('disaster-triggers-list');
  const protocolsList = document.getElementById('disaster-protocols-list');
  const timestampEl = document.getElementById('disaster-timestamp');
  const btnOpenSos = document.getElementById('btn-disaster-open-sos');
  const btnManual = document.getElementById('disaster-view-manual-btn');

  let lastDisasterData: any = null;

  btnOpenSos?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-sos-hub'));
  });

  btnManual?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-sos-hub'));
  });

  function renderDisaster(data: any) {
    if (!data) return;
    lastDisasterData = data;

    if (data.isDisasterActive && data.disasterDetails) {
      const details = data.disasterDetails;
      const alertLevel = details.alertLevel || (details.severity === 'Extreme' ? 'Red' : details.severity === 'Severe' ? 'Orange' : 'Yellow');

      const transTitle = I18nService.t(details.disasterName, details.disasterName);
      const transDesc = I18nService.t(details.description, details.description);

      if (title) title.textContent = transTitle;
      if (desc) desc.textContent = transDesc;
      if (timestampEl && details.timestamp) timestampEl.textContent = details.timestamp;

      // Dynamic color theme adaptation
      if (alertLevel === 'Red') {
        if (cardWrapper) {
          cardWrapper.className = 'rounded-3xl bg-gradient-to-b from-red-950/95 via-slate-900/90 to-slate-950/95 border-2 border-red-500/70 p-5 sm:p-7 shadow-[0_0_60px_rgba(239,68,68,0.35)] relative overflow-hidden transition-all';
        }
        if (accentBar) {
          accentBar.className = 'absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-red-600 via-rose-500 to-amber-500 animate-pulse';
        }
        if (iconBox) {
          iconBox.textContent = '🚨';
          iconBox.className = 'w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-red-600/30 border border-red-500/60 text-3xl flex items-center justify-center animate-bounce shadow-[0_0_25px_rgba(239,68,68,0.5)] shrink-0';
        }
        if (badge) {
          badge.textContent = I18nService.t('CRITICAL RED ALERT', 'CRITICAL RED ALERT');
          badge.className = 'text-[10px] font-black uppercase tracking-widest px-2.5 py-0.5 rounded bg-red-600 text-white animate-pulse';
        }
        if (desc) desc.className = 'text-xs sm:text-sm text-red-200/90 mt-1 max-w-3xl leading-relaxed';
      } else if (alertLevel === 'Orange') {
        if (cardWrapper) {
          cardWrapper.className = 'rounded-3xl bg-gradient-to-b from-amber-950/90 via-slate-900/90 to-slate-950/95 border-2 border-amber-500/70 p-5 sm:p-7 shadow-[0_0_60px_rgba(245,158,11,0.25)] relative overflow-hidden transition-all';
        }
        if (accentBar) {
          accentBar.className = 'absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-600 animate-pulse';
        }
        if (iconBox) {
          iconBox.textContent = '⚠️';
          iconBox.className = 'w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-amber-600/30 border border-amber-500/60 text-3xl flex items-center justify-center shadow-[0_0_25px_rgba(245,158,11,0.4)] shrink-0';
        }
        if (badge) {
          badge.textContent = I18nService.t('SEVERE ORANGE ALERT', 'SEVERE ORANGE ALERT');
          badge.className = 'text-[10px] font-black uppercase tracking-widest px-2.5 py-0.5 rounded bg-amber-600 text-white animate-pulse';
        }
        if (desc) desc.className = 'text-xs sm:text-sm text-amber-200/90 mt-1 max-w-3xl leading-relaxed';
      } else {
        // Yellow Advisory
        if (cardWrapper) {
          cardWrapper.className = 'rounded-3xl bg-gradient-to-b from-yellow-950/80 via-slate-900/90 to-slate-950/95 border-2 border-yellow-500/60 p-5 sm:p-7 shadow-[0_0_50px_rgba(234,179,8,0.2)] relative overflow-hidden transition-all';
        }
        if (accentBar) {
          accentBar.className = 'absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-yellow-500 via-amber-400 to-emerald-400';
        }
        if (iconBox) {
          iconBox.textContent = '⚡';
          iconBox.className = 'w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-yellow-600/30 border border-yellow-500/60 text-3xl flex items-center justify-center shadow-[0_0_20px_rgba(234,179,8,0.3)] shrink-0';
        }
        if (badge) {
          badge.textContent = I18nService.t('YELLOW ADVISORY', 'YELLOW ADVISORY');
          badge.className = 'text-[10px] font-black uppercase tracking-widest px-2.5 py-0.5 rounded bg-yellow-600 text-slate-950 font-bold';
        }
        if (desc) desc.className = 'text-xs sm:text-sm text-yellow-100/90 mt-1 max-w-3xl leading-relaxed';
      }

      // Populate Triggers
      if (triggersList) {
        triggersList.innerHTML = (details.triggerReasons || []).map((r: string) => {
          const transR = I18nService.t(r, r);
          return `
            <li class="flex items-start gap-2.5">
              <span class="w-2 h-2 rounded-full ${alertLevel === 'Red' ? 'bg-red-400' : alertLevel === 'Orange' ? 'bg-amber-400' : 'bg-yellow-400'} shrink-0 mt-1.5"></span>
              <span class="leading-relaxed">${transR}</span>
            </li>
          `;
        }).join('');
      }

      // Populate Protocols
      if (protocolsList) {
        protocolsList.innerHTML = (details.activeProtocols || []).map((p: string) => {
          const transP = I18nService.t(p, p);
          return `
            <li class="flex items-start gap-2.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0 mt-1.5"></span>
              <span class="leading-relaxed">${transP}</span>
            </li>
          `;
        }).join('');
      }

      container?.classList.remove('hidden');
    } else {
      container?.classList.add('hidden');
    }
  }

  window.addEventListener('mausam-weather-updated', (e: any) => {
    renderDisaster(e.detail);
  });

  window.addEventListener('mausam-language-changed', () => {
    if (container) I18nService.translateDocument(container);
    if (lastDisasterData) {
      renderDisaster(lastDisasterData);
    }
  });
</script>

