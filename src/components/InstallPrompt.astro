---
// src/components/InstallPrompt.astro
// PWA Install Prompt Banner
---

<div id="pwa-install-banner" class="hidden fixed bottom-16 sm:bottom-6 right-4 sm:right-6 z-50 glass-panel rounded-2xl p-4 border border-emerald-400/40 shadow-2xl max-w-sm">
  <div class="flex items-start gap-3">
    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-xl shrink-0">
      🌾
    </div>
    <div class="flex-1 min-w-0">
      <h4 class="text-xs font-bold text-white">Install Mausam Weather</h4>
      <p class="text-[11px] text-slate-300 font-light mt-0.5">
        Install app for offline radar, SOS beacon, and instant crop advisories.
      </p>
      <div class="flex items-center gap-2 mt-3">
        <button id="pwa-btn-install" class="px-3 py-1 rounded-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition-all active-scale cursor-pointer">
          Install Now
        </button>
        <button id="pwa-btn-dismiss" class="px-3 py-1 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 text-xs transition-all cursor-pointer">
          Later
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let deferredPrompt: any = null;
  const banner = document.getElementById('pwa-install-banner');
  const btnInstall = document.getElementById('pwa-btn-install');
  const btnDismiss = document.getElementById('pwa-btn-dismiss');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    banner?.classList.remove('hidden');
  });

  btnInstall?.addEventListener('click', async () => {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      if (outcome === 'accepted') {
        banner?.classList.add('hidden');
      }
      deferredPrompt = null;
    }
  });

  btnDismiss?.addEventListener('click', () => {
    banner?.classList.add('hidden');
  });

  document.getElementById('nav-install-btn')?.addEventListener('click', () => {
    if (deferredPrompt) {
      deferredPrompt.prompt();
    } else {
      alert('To install Mausam: Click your browser menu (⋮ or Share) and select "Add to Home Screen" or "Install App".');
    }
  });
</script>
