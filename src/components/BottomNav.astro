---
// src/components/BottomNav.astro
// Mobile Bottom Navigation Dock Bar
---

<div class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-[#0B0F19]/95 backdrop-blur-xl border-t border-white/[0.08] px-4 py-2 flex items-center justify-around text-xs shadow-2xl" id="bottom-dock-nav">
  
  <a href="/" class="flex flex-col items-center gap-1 text-emerald-400 font-bold active-scale">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
    </svg>
    <span data-i18n="home" class="text-[10px]">Home</span>
  </a>

  <button type="button" id="dock-radar-btn" class="flex flex-col items-center gap-1 text-slate-400 hover:text-cyan-300 transition-colors active-scale cursor-pointer">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 3a9 9 0 0 1 9 9"></path>
      <circle cx="12" cy="12" r="2"></circle>
    </svg>
    <span data-i18n="radar" class="text-[10px]">Radar</span>
  </button>

  <button type="button" id="dock-sos-btn" class="sos-hub-trigger flex flex-col items-center gap-1 text-red-400 font-bold active-scale cursor-pointer">
    <div class="w-6 h-6 rounded-full bg-red-500/20 flex items-center justify-center text-xs">
      🛡️
    </div>
    <span data-i18n="sosHub" class="text-[10px]">SOS</span>
  </button>

  <a href="/farmer" class="flex flex-col items-center gap-1 text-slate-400 hover:text-emerald-300 transition-colors active-scale">
    <span class="text-base">🌾</span>
    <span data-i18n="agri" class="text-[10px]">Agri</span>
  </a>

  <button type="button" id="dock-profile-btn" class="flex flex-col items-center gap-1 text-slate-400 hover:text-white transition-colors active-scale cursor-pointer">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
    </svg>
    <span data-i18n="profile" class="text-[10px]">Profile</span>
  </button>

</div>

<script>
  import { I18nService } from '../services/i18n.service';

  document.getElementById('dock-radar-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-radar'));
  });

  document.getElementById('dock-profile-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mausam-open-profile-settings'));
  });

  window.addEventListener('mausam-language-changed', () => {
    const dock = document.getElementById('bottom-dock-nav');
    if (dock) I18nService.translateDocument(dock);
  });
</script>
