---
// src/components/FarmerDashboard.astro
// High-Resolution Aesthetic Glassmorphism Agricultural Assistant

interface Props {
  isStandalone?: boolean;
  defaultLocation?: string;
}

const {
  isStandalone = false,
  defaultLocation = 'Greater Noida'
} = Astro.props;
---

<div id="farmer-dashboard-root" class={`w-full relative overflow-hidden ${isStandalone ? 'max-w-[1440px] mx-auto px-4 sm:px-6 py-6' : ''}`}>
  
  <!-- Ambient Studio Lighting & Aurora Glows -->
  <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-emerald-500/15 blur-[120px] pointer-events-none aurora-glow-1"></div>
  <div class="absolute top-1/3 -right-32 w-96 h-96 rounded-full bg-cyan-500/15 blur-[120px] pointer-events-none aurora-glow-2"></div>
  <div class="absolute -bottom-32 left-1/3 w-96 h-96 rounded-full bg-violet-500/10 blur-[140px] pointer-events-none"></div>

  <!-- Header Branding & Engine Status -->
  <div class="relative z-10 mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 glass-panel rounded-2xl p-5 sm:p-6 border border-white/10 shadow-glass">
      
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-400/20 via-emerald-500/30 to-cyan-500/20 border border-emerald-400/30 flex items-center justify-center text-2xl shadow-glow-emerald">
          🌾
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl sm:text-2xl font-bold text-white tracking-apple-tight">
              Mausam Precision Agri-Intelligence
            </h1>
            <span class="text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              v2.5 Pro
            </span>
          </div>
          <p class="text-xs sm:text-sm text-slate-300 mt-0.5">
            Real-time agro-meteorological guidance & Gemini AI agronomy advisor
          </p>
        </div>
      </div>

      <!-- Quick Status Badges -->
      <div class="flex flex-wrap items-center gap-2.5">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900/80 border border-white/10 text-xs text-slate-200">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-glow-emerald"></span>
          <span id="farmer-source-text" class="font-medium text-emerald-300">Gemini AI Active</span>
        </div>
        
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-900/80 border border-white/10 text-xs text-slate-300">
          <span>📡</span>
          <span id="farmer-weather-loc-badge" class="font-medium text-cyan-300">{defaultLocation}</span>
        </div>
      </div>

    </div>
  </div>

  <!-- 1. Interactive Crop Selection Tiles (Aesthetic Glass Cards) -->
  <div class="relative z-10 mb-6">
    <div class="flex items-center justify-between mb-3 px-1">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
        <span>🌱</span> Select Target Crop
      </span>
      <span class="text-xs text-slate-400">Click to switch instantly</span>
    </div>

    <!-- 5 Visual Crop Selector Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3" id="farmer-crop-cards-container">
      
      <button type="button" data-crop-val="Wheat" class="crop-card active-scale p-3.5 rounded-xl text-left transition-all duration-200 cursor-pointer border relative overflow-hidden bg-slate-900/60 border-emerald-400 shadow-[0_0_20px_rgba(16,185,129,0.2)] ring-1 ring-emerald-400/50">
        <div class="flex items-center justify-between mb-2">
          <span class="text-2xl">🌾</span>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300">Rabi</span>
        </div>
        <div class="font-semibold text-sm text-white">Wheat</div>
        <div class="text-xs text-slate-400 font-normal">गेहूं (Cereal)</div>
      </button>

      <button type="button" data-crop-val="Rice" class="crop-card active-scale p-3.5 rounded-xl text-left transition-all duration-200 cursor-pointer border relative overflow-hidden bg-slate-900/40 border-white/10 hover:border-white/20 hover:bg-slate-900/60">
        <div class="flex items-center justify-between mb-2">
          <span class="text-2xl">🍚</span>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300">Kharif</span>
        </div>
        <div class="font-semibold text-sm text-white">Rice / Paddy</div>
        <div class="text-xs text-slate-400 font-normal">धान (Wetland)</div>
      </button>

      <button type="button" data-crop-val="Maize" class="crop-card active-scale p-3.5 rounded-xl text-left transition-all duration-200 cursor-pointer border relative overflow-hidden bg-slate-900/40 border-white/10 hover:border-white/20 hover:bg-slate-900/60">
        <div class="flex items-center justify-between mb-2">
          <span class="text-2xl">🌽</span>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300">Coarse</span>
        </div>
        <div class="font-semibold text-sm text-white">Maize</div>
        <div class="text-xs text-slate-400 font-normal">मक्का (Corn)</div>
      </button>

      <button type="button" data-crop-val="Cotton" class="crop-card active-scale p-3.5 rounded-xl text-left transition-all duration-200 cursor-pointer border relative overflow-hidden bg-slate-900/40 border-white/10 hover:border-white/20 hover:bg-slate-900/60">
        <div class="flex items-center justify-between mb-2">
          <span class="text-2xl">☁️</span>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-violet-500/20 text-violet-300">Cash</span>
        </div>
        <div class="font-semibold text-sm text-white">Cotton</div>
        <div class="text-xs text-slate-400 font-normal">कपास (Fiber)</div>
      </button>

      <button type="button" data-crop-val="Sugarcane" class="crop-card active-scale p-3.5 rounded-xl text-left transition-all duration-200 cursor-pointer border relative overflow-hidden bg-slate-900/40 border-white/10 hover:border-white/20 hover:bg-slate-900/60 col-span-2 sm:col-span-1">
        <div class="flex items-center justify-between mb-2">
          <span class="text-2xl">🎋</span>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300">Annual</span>
        </div>
        <div class="font-semibold text-sm text-white">Sugarcane</div>
        <div class="text-xs text-slate-400 font-normal">गन्ना (Sugar)</div>
      </button>

    </div>
  </div>

  <!-- 2. Interactive Growth Stage Stepper & Controls Strip -->
  <div class="relative z-10 mb-8 glass-panel rounded-2xl p-5 sm:p-6 border border-white/10 shadow-glass">
    
    <!-- Stage Stepper Title & Progress -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4 pb-3 border-b border-white/10">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
        <span>🔄</span> Phenological Growth Stage
      </span>
      <span id="farmer-stage-progress-label" class="text-xs text-emerald-400 font-medium">Stage 1 of 4 • Sowing Phase (Seedbed & Emergence)</span>
    </div>

    <!-- Interactive 4-Step Stepper Line -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6" id="farmer-stage-stepper-container">
      
      <button type="button" data-stage-val="Sowing" class="stage-step-btn p-3 rounded-xl border text-left transition-all active-scale cursor-pointer bg-emerald-500/15 border-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.2)]">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-6 h-6 rounded-full bg-emerald-500 text-slate-950 text-xs flex items-center justify-center font-bold step-num">1</span>
          <span class="text-xs font-semibold text-white">Sowing</span>
        </div>
        <p class="text-[11px] text-emerald-300 pl-8">Seedbed & Emergence</p>
      </button>

      <button type="button" data-stage-val="Vegetative" class="stage-step-btn p-3 rounded-xl border text-left transition-all active-scale cursor-pointer bg-slate-900/40 border-white/10 hover:border-emerald-500/40 hover:bg-slate-800/50">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-6 h-6 rounded-full bg-slate-800 border border-white/20 text-xs flex items-center justify-center font-bold text-slate-300 step-num">2</span>
          <span class="text-xs font-semibold text-white">Vegetative</span>
        </div>
        <p class="text-[11px] text-slate-400 pl-8">Crown Root & Tillering</p>
      </button>

      <button type="button" data-stage-val="Flowering" class="stage-step-btn p-3 rounded-xl border text-left transition-all active-scale cursor-pointer bg-slate-900/40 border-white/10 hover:border-emerald-500/40 hover:bg-slate-800/50">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-6 h-6 rounded-full bg-slate-800 border border-white/20 text-xs flex items-center justify-center font-bold text-slate-300 step-num">3</span>
          <span class="text-xs font-semibold text-white">Flowering</span>
        </div>
        <p class="text-[11px] text-slate-400 pl-8">Boot Leaf & Anthesis</p>
      </button>

      <button type="button" data-stage-val="Harvesting" class="stage-step-btn p-3 rounded-xl border text-left transition-all active-scale cursor-pointer bg-slate-900/40 border-white/10 hover:border-emerald-500/40 hover:bg-slate-800/50">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-6 h-6 rounded-full bg-slate-800 border border-white/20 text-xs flex items-center justify-center font-bold text-slate-300 step-num">4</span>
          <span class="text-xs font-semibold text-white">Harvesting</span>
        </div>
        <p class="text-[11px] text-slate-400 pl-8">Grain Ripening & Cut</p>
      </button>

    </div>

    <!-- Location Filter Bar & Quick Region Pills -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-center pt-2">
      
      <!-- Location Input (7 cols) -->
      <div class="lg:col-span-8 flex flex-col gap-2">
        <div class="relative">
          <div class="absolute left-4 top-1/2 -translate-y-1/2 text-cyan-400 pointer-events-none text-base">
            📍
          </div>
          <input 
            type="text" 
            id="farmer-location-input" 
            value={defaultLocation}
            placeholder="Search farm location (e.g., Greater Noida, Ludhiana, Karnal)..." 
            autocomplete="off"
            class="w-full h-12 pl-11 pr-24 glass-input rounded-xl text-sm font-medium tracking-apple-tight"
          />
          <button 
            type="button" 
            id="farmer-gps-btn" 
            class="absolute right-3 top-1/2 -translate-y-1/2 px-2.5 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 text-xs font-medium border border-emerald-500/30 transition-colors flex items-center gap-1 active-scale cursor-pointer"
            title="Use current device GPS location"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
            </svg>
            <span>GPS</span>
          </button>
          
          <!-- Autocomplete Dropdown -->
          <div id="farmer-search-dropdown" class="absolute left-0 top-full mt-2 w-full rounded-2xl shadow-[0_20px_60px_rgba(0,0,0,0.95)] hidden max-h-60 overflow-y-auto z-[99999] border border-white/20 divide-y divide-white/10 backdrop-blur-2xl bg-[#090D18]/98"></div>
        </div>

        <!-- Quick Region Selector Pills -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
          <span class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold mr-1">Quick Select:</span>
          <button type="button" class="quick-loc-pill px-2.5 py-1 rounded-full bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-emerald-300 border border-white/5 transition-all cursor-pointer" data-loc="Greater Noida">Greater Noida</button>
          <button type="button" class="quick-loc-pill px-2.5 py-1 rounded-full bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-emerald-300 border border-white/5 transition-all cursor-pointer" data-loc="Ludhiana">Ludhiana</button>
          <button type="button" class="quick-loc-pill px-2.5 py-1 rounded-full bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-emerald-300 border border-white/5 transition-all cursor-pointer" data-loc="Karnal">Karnal</button>
          <button type="button" class="quick-loc-pill px-2.5 py-1 rounded-full bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-emerald-300 border border-white/5 transition-all cursor-pointer" data-loc="Nagpur">Nagpur</button>
          <button type="button" class="quick-loc-pill px-2.5 py-1 rounded-full bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-emerald-300 border border-white/5 transition-all cursor-pointer" data-loc="Meerut">Meerut</button>
        </div>
      </div>

      <!-- Action Button & Simulation (4 cols) -->
      <div class="lg:col-span-4 flex items-center gap-2">
        <button 
          type="button" 
          id="farmer-fetch-btn" 
          class="flex-1 h-12 px-6 bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 text-sm font-bold rounded-xl active-scale transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-glow-emerald"
        >
          <svg id="farmer-fetch-spinner" class="w-4 h-4 animate-spin hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span id="farmer-fetch-btn-text">Generate Advisory</span>
          <span id="farmer-fetch-arrow">⚡</span>
        </button>
      </div>

    </div>

  </div>

  <!-- 3. Micro-Climate & Soil Gauges Overview (4 Glass Cards) -->
  <div class="relative z-10 mb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- Card 1: Soil Moisture Gauge -->
      <div class="glass-card-interactive rounded-2xl p-5 relative overflow-hidden flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
            <span>💧</span> Soil Moisture
          </span>
          <span id="farmer-moisture-badge" class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Optimal
          </span>
        </div>
        
        <div class="flex items-baseline justify-between mb-2">
          <div class="text-3xl font-extrabold text-white tracking-apple-tight" id="farmer-moisture-val">
            68%
          </div>
          <span class="text-xs text-slate-400">15cm root-depth</span>
        </div>

        <!-- Visual Progress Bar -->
        <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden mb-2">
          <div id="farmer-moisture-bar" class="h-full bg-gradient-to-r from-emerald-500 to-cyan-400 rounded-full transition-all duration-700" style="width: 68%;"></div>
        </div>

        <p id="farmer-moisture-desc" class="text-[11px] text-slate-300 leading-relaxed">
          Hydration is in prime buffer zone. Capillary flow adequate.
        </p>
      </div>

      <!-- Card 2: 24h Rainfall Forecast -->
      <div class="glass-card-interactive rounded-2xl p-5 relative overflow-hidden flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-cyan-400 flex items-center gap-1.5">
            <span>🌧️</span> 24h Precipitation
          </span>
          <span id="farmer-rain-badge" class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
            Dry Window
          </span>
        </div>

        <div class="flex items-baseline justify-between mb-2">
          <div class="text-3xl font-extrabold text-white tracking-apple-tight" id="farmer-rain-val">
            0.0 mm
          </div>
          <span class="text-xs text-slate-400">Rain Prob: <span id="farmer-rain-prob" class="text-cyan-300 font-semibold">10%</span></span>
        </div>

        <!-- Visual Progress Bar -->
        <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden mb-2">
          <div id="farmer-rain-bar" class="h-full bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full transition-all duration-700" style="width: 10%;"></div>
        </div>

        <p id="farmer-rain-desc" class="text-[11px] text-slate-300 leading-relaxed">
          Clear field window. Suitable for weeding & spraying.
        </p>
      </div>

      <!-- Card 3: Ambient Temperature & Humidity -->
      <div class="glass-card-interactive rounded-2xl p-5 relative overflow-hidden flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
            <span>🌡️</span> Ambient Climate
          </span>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30" id="farmer-climate-status">
            Mild
          </span>
        </div>

        <div class="flex items-baseline justify-between mb-2">
          <div class="text-3xl font-extrabold text-white tracking-apple-tight" id="farmer-temp-val">
            28.0°C
          </div>
          <span class="text-xs font-semibold text-slate-300" id="farmer-humidity-val">RH: 65%</span>
        </div>

        <!-- Wind indicator -->
        <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2">
          <span id="farmer-wind-val">💨 Wind: 14 km/h NW</span>
          <span id="farmer-condition-val" class="text-slate-300">Partly Sunny</span>
        </div>

        <p id="farmer-condition-desc" class="text-[11px] text-slate-300 leading-relaxed">
          Thermal units accelerating vegetative cell development.
        </p>
      </div>

      <!-- Card 4: Agronomic Risk & Yield Health -->
      <div class="glass-card-interactive rounded-2xl p-5 relative overflow-hidden flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-violet-400 flex items-center gap-1.5">
            <span>🛡️</span> Crop Risk Index
          </span>
          <span id="farmer-hazard-badge" class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Favorable
          </span>
        </div>

        <div class="flex items-baseline justify-between mb-2">
          <div class="text-3xl font-extrabold text-white tracking-apple-tight" id="farmer-hazard-val">
            Low Risk
          </div>
          <span class="text-xs text-emerald-400 font-semibold" id="farmer-yield-est">Yield: 95%</span>
        </div>

        <!-- Visual Risk Meter -->
        <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden mb-2">
          <div id="farmer-risk-bar" class="h-full bg-gradient-to-r from-emerald-400 to-teal-300 rounded-full transition-all duration-700" style="width: 20%;"></div>
        </div>

        <p id="farmer-hazard-desc" class="text-[11px] text-slate-300 leading-relaxed">
          No acute frost or heat desiccation threats detected.
        </p>
      </div>

    </div>
  </div>

  <!-- 4. Interactive Tabs Navigator (Advisory vs Telemetry vs Soil Sensors vs Calculator) -->
  <div class="relative z-10 mb-6 flex flex-wrap items-center gap-2 border-b border-white/10 pb-3">
    
    <button type="button" data-tab-target="tab-advisory" class="farmer-tab-btn active-scale px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-gradient-to-r from-emerald-500/30 to-teal-500/30 text-emerald-300 border border-emerald-500/40 shadow-glow-emerald">
      🎯 AI Advisory & Field Action Plan
    </button>
    
    <button type="button" data-tab-target="tab-telemetry" class="farmer-tab-btn active-scale px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-white border border-white/10">
      📈 24h Climate & Rain Telemetry Graph
    </button>
    
    <button type="button" data-tab-target="tab-soil" class="farmer-tab-btn active-scale px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-white border border-white/10">
      🧪 Soil Sensors & NPK Dashboard
    </button>
    
    <button type="button" data-tab-target="tab-calculator" class="farmer-tab-btn active-scale px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-white border border-white/10">
      🧮 Agronomic Seed & Water Calculator
    </button>

  </div>

  <!-- TAB 1: AI Advisory & Field Action Plan (Default) -->
  <div id="tab-advisory" class="farmer-tab-pane space-y-6">
    
    <!-- AI Weather Impact Banner (Glassmorphism Violet / Emerald Glow) -->
    <div class="relative overflow-hidden rounded-2xl p-6 sm:p-8 border border-white/15 shadow-2xl bg-gradient-to-br from-slate-900/90 via-slate-900/80 to-slate-950/90" id="farmer-advisory-tile">
      
      <!-- Gradient mesh accent lines -->
      <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-emerald-500 via-cyan-400 to-violet-500"></div>
      
      <div class="relative z-10 max-w-[1200px]">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-violet-500/20 text-violet-300 border border-violet-500/30 text-xs font-bold uppercase tracking-wider shadow-glow-violet">
            <span>✨</span> Gemini AI Agronomic Analysis
          </div>
          <span class="text-xs px-3 py-1 rounded-full bg-white/10 text-slate-200 border border-white/10 font-medium" id="farmer-crop-stage-pill">
            Wheat • Sowing Stage
          </span>
          <span class="text-xs text-slate-400 ml-auto" id="farmer-weather-timestamp">Updated just now</span>
        </div>

        <p id="farmer-weather-advisory-text" class="text-lg sm:text-xl font-normal leading-relaxed text-slate-100 tracking-apple-tight mb-4">
          Analyzing environmental factors and soil parameters for your selected crop...
        </p>

