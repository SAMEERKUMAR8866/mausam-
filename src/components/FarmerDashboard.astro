<!-- Client Script for Interactive Controls & Real-time Visual Updates -->
<script>
  import { StorageService } from '../services/storage.service';
  import { NetworkService } from '../services/network.service';

  const initialSettings = StorageService.getProfileCustomSettings('farmer');
  let currentCrop = initialSettings.target_crop || localStorage.getItem('mausam_farmer_crop') || 'Wheat';
  let currentStage = initialSettings.growth_stage || localStorage.getItem('mausam_farmer_stage') || 'Sowing';
  let currentLocation = localStorage.getItem('mausam_farmer_location') || 'Greater Noida';
  let farmerRequestId = 0;
  let searchDebounce: ReturnType<typeof setTimeout> | null = null;
  let completedActions: Set<number> = new Set(JSON.parse(localStorage.getItem('mausam_actions_done') || '[]'));

  // DOM Elements
  const locationInput = document.getElementById('farmer-location-input') as HTMLInputElement | null;
  const searchDropdown = document.getElementById('farmer-search-dropdown');
  const fetchBtn = document.getElementById('farmer-fetch-btn');
  const fetchBtnText = document.getElementById('farmer-fetch-btn-text');
  const fetchSpinner = document.getElementById('farmer-fetch-spinner');
  const fetchArrow = document.getElementById('farmer-fetch-arrow');
  const gpsBtn = document.getElementById('farmer-gps-btn');
  const errorBox = document.getElementById('farmer-error-box');
  const errorMsg = document.getElementById('farmer-error-msg');
  const errorRetryBtn = document.getElementById('farmer-error-retry-btn');

  // Weather Displays
  const weatherLocBadge = document.getElementById('farmer-weather-loc-badge');
  const weatherTimestamp = document.getElementById('farmer-weather-timestamp');
  const moistureVal = document.getElementById('farmer-moisture-val');
  const moistureBadge = document.getElementById('farmer-moisture-badge');
  const moistureBar = document.getElementById('farmer-moisture-bar');
  const moistureDesc = document.getElementById('farmer-moisture-desc');
  
  const rainVal = document.getElementById('farmer-rain-val');
  const rainBadge = document.getElementById('farmer-rain-badge');
  const rainBar = document.getElementById('farmer-rain-bar');
  const rainProb = document.getElementById('farmer-rain-prob');
  const rainDesc = document.getElementById('farmer-rain-desc');
  
  const tempVal = document.getElementById('farmer-temp-val');
  const humidityVal = document.getElementById('farmer-humidity-val');
  const windVal = document.getElementById('farmer-wind-val');
  const conditionVal = document.getElementById('farmer-condition-val');
  const conditionDesc = document.getElementById('farmer-condition-desc');
  const climateStatus = document.getElementById('farmer-climate-status');
  
  const hazardVal = document.getElementById('farmer-hazard-val');
  const hazardBadge = document.getElementById('farmer-hazard-badge');
  const riskBar = document.getElementById('farmer-risk-bar');
  const hazardDesc = document.getElementById('farmer-hazard-desc');
  const yieldEst = document.getElementById('farmer-yield-est');

  // Advisory Displays
  const advisoryText = document.getElementById('farmer-weather-advisory-text');
  const summaryText = document.getElementById('farmer-summary-text');
  const cropStagePill = document.getElementById('farmer-crop-stage-pill');
  const actionItemsContainer = document.getElementById('farmer-action-items-container');
  const riskWarningsContainer = document.getElementById('farmer-risk-warnings-container');
  const stageTipText = document.getElementById('farmer-stage-tip-text');
  const sourceText = document.getElementById('farmer-source-text');
  const actionProgress = document.getElementById('farmer-action-progress');
  const stageProgressLabel = document.getElementById('farmer-stage-progress-label');

  // Calculator Elements
  const calcAcresInput = document.getElementById('calc-acres-input') as HTMLInputElement | null;
  const calcCropLabel = document.getElementById('calc-crop-label');
  const calcSeedOut = document.getElementById('calc-seed-out');
  const calcUreaOut = document.getElementById('calc-urea-out');
  const calcWaterOut = document.getElementById('calc-water-out');

  // 1. Interactive Tabs Switching
  const tabBtns = document.querySelectorAll('.farmer-tab-btn');
  const tabPanes = document.querySelectorAll('.farmer-tab-pane');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab-target');
      if (!targetId) return;

      tabBtns.forEach(b => {
        b.className = 'farmer-tab-btn active-scale px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-slate-900/60 hover:bg-slate-800 text-slate-300 hover:text-white border border-white/10';
      });
      btn.className = 'farmer-tab-btn active-scale px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-gradient-to-r from-emerald-500/30 to-teal-500/30 text-emerald-300 border border-emerald-500/40 shadow-glow-emerald';

      tabPanes.forEach(pane => {
        if (pane.id === targetId) pane.classList.remove('hidden');
        else pane.classList.add('hidden');
      });
    });
  });

  // 2. Interactive Crop Cards Switching
  function updateCropSelection(crop: string, triggerFetch: boolean = true) {
    currentCrop = crop;
    StorageService.setProfileCustomSetting('farmer', 'target_crop', crop);

    const cropCards = document.querySelectorAll('.crop-card');
    cropCards.forEach(card => {
      const cVal = card.getAttribute('data-crop-val');
      if (cVal === crop) {
        card.className = 'crop-card active-scale p-3.5 rounded-xl text-left transition-all duration-200 cursor-pointer border relative overflow-hidden bg-slate-900/80 border-emerald-400 shadow-[0_0_20px_rgba(16,185,129,0.3)] ring-1 ring-emerald-400/50';
      } else {
        card.className = 'crop-card active-scale p-3.5 rounded-xl text-left transition-all duration-200 cursor-pointer border relative overflow-hidden bg-slate-900/40 border-white/10 hover:border-white/20 hover:bg-slate-900/60';
      }
    });

    if (calcCropLabel) calcCropLabel.textContent = `🌾 ${crop}`;
    recalculateFarmDosage();
    if (triggerFetch) {
      loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
    }
  }

  document.querySelectorAll('.crop-card').forEach(card => {
    card.addEventListener('click', () => {
      const crop = card.getAttribute('data-crop-val');
      if (crop) updateCropSelection(crop, true);
    });
  });

  // 3. Interactive Growth Stage Stepper Switching
  function updateStageSelection(stage: string, triggerFetch: boolean = true) {
    currentStage = stage;
    StorageService.setProfileCustomSetting('farmer', 'growth_stage', stage);

    const stepBtns = document.querySelectorAll('.stage-step-btn');
    const stageNames = ['Sowing', 'Vegetative', 'Flowering', 'Harvesting'];
    const stepIdx = stageNames.indexOf(stage);

    if (stageProgressLabel) {
      stageProgressLabel.textContent = `Stage ${stepIdx + 1} of 4 • ${stage} Phase`;
    }

    stepBtns.forEach((btn) => {
      const sVal = btn.getAttribute('data-stage-val');
      const numSpan = btn.querySelector('.step-num');

      if (sVal === stage) {
        btn.className = 'stage-step-btn p-3 rounded-xl border text-left transition-all active-scale cursor-pointer bg-emerald-500/20 border-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.25)]';
        if (numSpan) numSpan.className = 'w-6 h-6 rounded-full bg-emerald-500 text-slate-950 text-xs flex items-center justify-center font-bold step-num';
      } else {
        btn.className = 'stage-step-btn p-3 rounded-xl border text-left transition-all active-scale cursor-pointer bg-slate-900/40 border-white/10 hover:border-emerald-500/40 hover:bg-slate-800/50';
        if (numSpan) numSpan.className = 'w-6 h-6 rounded-full bg-slate-800 border border-white/20 text-xs flex items-center justify-center font-bold text-slate-300 step-num';
      }
    });

    if (triggerFetch) {
      loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
    }
  }

  document.querySelectorAll('.stage-step-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const stage = btn.getAttribute('data-stage-val');
      if (stage) updateStageSelection(stage, true);
    });
  });

  // 4. Quick Location Selector Pills
  document.querySelectorAll('.quick-loc-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const loc = pill.getAttribute('data-loc');
      if (loc) {
        currentLocation = loc;
        if (locationInput) locationInput.value = loc;
        localStorage.setItem('mausam_farmer_location', loc);
        loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
      }
    });
  });

  // 5. Main Fetch & Advisory Renderer
  async function loadFarmerAdvisory(crop: string, stage: string, location: string) {
    const requestId = ++farmerRequestId;
    setLoadingState(true);
    hideError();

    if (cropStagePill) cropStagePill.textContent = `${crop} • ${stage} Stage`;
    if (weatherLocBadge) weatherLocBadge.textContent = location;

    try {
      const url = `/api/recommendations?crop=${encodeURIComponent(crop)}&stage=${encodeURIComponent(stage)}&q=${encodeURIComponent(location)}&location=${encodeURIComponent(location)}`;
      const response = await fetch(url);
      
      if (!response.ok) throw new Error(`Status ${response.status}`);
      const data = await response.json();

      if (requestId !== farmerRequestId) return;

      // Update weather UI
      if (data.weatherSummary) {
        updateWeatherUI(data.weatherSummary, data.location || location);
      }

      // Update AI Advisory banner
      if (advisoryText) {
        advisoryText.textContent = data.weatherAdvisory || data.recommendation || 'Analyzing field conditions...';
      }
      if (summaryText) {
        summaryText.textContent = data.summary || data.recommendation || 'Standard field monitoring recommended.';
      }
      if (stageTipText) {
        stageTipText.textContent = data.growthStageTips || `Follow optimal agronomy protocol for ${crop} during ${stage} phase.`;
      }
      if (sourceText) {
        sourceText.textContent = data.source === 'gemini' ? 'Gemini AI Advisor' : 'Agronomic Science Engine';
      }

      // Render Action Items with interactive checkboxes
      renderActionItems(data.cropActionItems || []);

      // Render Risk Alerts
      renderRiskWarnings(data.riskWarnings || []);

      if (weatherTimestamp) {
        const now = new Date();
        weatherTimestamp.textContent = `Live Telemetry at ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
      }

    } catch (err) {
      if (requestId === farmerRequestId) {
        console.error('Advisory fetch error:', err);
        showError('Unable to fetch live advisory. Fallback to local science guidelines.');
      }
    } finally {
      if (requestId === farmerRequestId) setLoadingState(false);
    }
  }

  function updateWeatherUI(summary: any, locName: string) {
    if (weatherLocBadge) weatherLocBadge.textContent = locName;

    // Soil Moisture
    const moisture = Math.round(summary.soil_moisture_pct ?? 50);
    if (moistureVal) moistureVal.textContent = `${moisture}%`;
    if (moistureBar) moistureBar.style.width = `${Math.min(100, moisture)}%`;
    if (moistureBadge) {
      if (moisture > 80) {
        moistureBadge.textContent = 'High Saturation';
        moistureBadge.className = 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30';
      } else if (moisture < 40) {
        moistureBadge.textContent = 'Moisture Deficit';
        moistureBadge.className = 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30';
      } else {
        moistureBadge.textContent = 'Optimal Range';
        moistureBadge.className = 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
      }
    }
    if (moistureDesc) {
      moistureDesc.textContent = moisture > 80 
        ? 'Soil saturated. Hold off on extra irrigation.'
        : moisture < 40 
        ? 'Moisture deficit. Early morning irrigation recommended.'
        : 'Good root hydration for active nutrient uptake.';
    }

    // Rainfall
    const rain = summary.rainfall_prediction_24h_mm ?? 0;
    if (rainVal) rainVal.textContent = `${rain.toFixed(1)} mm`;
    const rainProbability = rain > 2 ? 75 : 10;
    if (rainProb) rainProb.textContent = `${rainProbability}%`;
    if (rainBar) rainBar.style.width = `${rainProbability}%`;
    if (rainBadge) {
      if (rain > 10) {
        rainBadge.textContent = 'Heavy Rain Alert';
        rainBadge.className = 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-blue-600 text-white shadow-glow-cyan';
      } else if (rain > 2) {
        rainBadge.textContent = 'Showers Expected';
        rainBadge.className = 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-blue-500/30 text-blue-300 border border-blue-400/30';
      } else {
        rainBadge.textContent = 'Dry Window';
        rainBadge.className = 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-white/10';
      }
    }
    if (rainDesc) {
      rainDesc.textContent = rain > 2 
        ? 'Precipitation expected in next 24h. Postpone foliar spraying.'
        : 'Dry conditions favor intercultural weeding & fertilizer.';
    }

    // Temperature & Wind
    const temp = summary.temp_c ?? 25;
    const humidity = summary.humidity ?? 60;
    if (tempVal) tempVal.textContent = `${temp.toFixed(1)}°C`;
    if (humidityVal) humidityVal.textContent = `RH: ${humidity}%`;
    if (windVal) windVal.textContent = `💨 Wind: ${summary.wind_kph || 12} km/h`;
    if (conditionVal) conditionVal.textContent = summary.condition || 'Clear';
    if (climateStatus) {
      climateStatus.textContent = temp > 35 ? 'Heat Wave' : temp < 10 ? 'Cold Chill' : 'Pleasant';
    }

    // Hazards
    const frost = summary.frost_alert || temp < 3;
    const heat = temp > 35;
    if (hazardVal) hazardVal.textContent = frost ? 'Frost Alert' : heat ? 'Heat Stress' : 'Low Risk';
    if (hazardBadge) {
      hazardBadge.textContent = frost ? 'Cold Chill' : heat ? 'Thermal Peak' : 'Favorable';
      hazardBadge.className = frost 
        ? 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-400/30'
        : heat 
        ? 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-400/30'
        : 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30';
    }
    if (riskBar) {
      riskBar.style.width = frost || heat ? '85%' : '20%';
    }
    if (conditionDesc) {
      conditionDesc.textContent = `${summary.condition || 'Clear'} • Ideal vegetative micro-climate.`;
    }
    if (hazardDesc) {
      hazardDesc.textContent = frost 
        ? 'Ground freeze danger. Provide light overnight sprinkler.'
        : heat 
        ? 'Thermal stress. Maintain soil moisture buffer.'
        : 'Micro-climate parameters are safe and stable.';
    }
    if (yieldEst) {
      yieldEst.textContent = frost || heat ? 'Yield: 78%' : 'Yield: 95%';
    }
  }

  // Render Action Items with interactive checkboxes
  function renderActionItems(items: any[]) {
    if (!actionItemsContainer) return;

    if (items.length === 0) {
      actionItemsContainer.innerHTML = `
        <div class="glass-panel rounded-xl p-5 text-xs text-slate-400 text-center">
          No urgent actions required today. Routine monitoring advised.
        </div>
      `;
      return;
    }

    actionItemsContainer.innerHTML = items.map((item, idx) => {
      const isDone = completedActions.has(idx);
      const priorityBadge = item.priority === 'high'
        ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30'
        : item.priority === 'medium'
        ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'
        : 'bg-slate-800 text-slate-300 border border-white/10';

      return `
        <div class="action-item-card glass-card-interactive rounded-xl p-4 transition-all duration-200 ${isDone ? 'opacity-55 border-emerald-500/30 bg-emerald-950/20' : ''}" data-idx="${idx}">
          <div class="flex items-start gap-3">
            <button type="button" class="action-checkbox-btn mt-0.5 w-5 h-5 rounded-md border flex items-center justify-center transition-all cursor-pointer ${isDone ? 'bg-emerald-500 border-emerald-400 text-slate-950' : 'bg-slate-800/80 border-white/20 hover:border-emerald-400 text-transparent'}" data-idx="${idx}">
              <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="text-base">${item.icon || '📌'}</span>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-200">${item.category || 'Field Duty'}</span>
                </div>
                <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full ${priorityBadge}">
                  ${item.priority || 'Routine'}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed ${isDone ? 'line-through text-slate-400' : ''}">
                ${item.action}
              </p>
            </div>
          </div>
        </div>
      `;
    }).join('');

    updateActionProgress(items.length);

    // Attach interactive checkbox listeners
    actionItemsContainer.querySelectorAll('.action-checkbox-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = Number(btn.getAttribute('data-idx'));
        if (completedActions.has(idx)) completedActions.delete(idx);
        else completedActions.add(idx);
        localStorage.setItem('mausam_actions_done', JSON.stringify(Array.from(completedActions)));
        renderActionItems(items);
      });
    });
  }

  function updateActionProgress(total: number) {
    if (!actionProgress) return;
    const doneCount = completedActions.size;
    actionProgress.textContent = `${doneCount} of ${total} Completed`;
    actionProgress.className = doneCount === total 
      ? 'text-xs font-semibold text-emerald-300' 
      : 'text-xs font-semibold text-cyan-400';
  }

  // Render Risk Alerts
  function renderRiskWarnings(warnings: any[]) {
    if (!riskWarningsContainer) return;

    if (warnings.length === 0) {
      riskWarningsContainer.innerHTML = `
        <div class="glass-panel rounded-xl p-4 text-xs text-slate-400 text-center">
          No active weather hazards. Conditions are balanced.
        </div>
      `;
      return;
    }

    riskWarningsContainer.innerHTML = warnings.map(warn => {
      const isCritical = warn.severity === 'critical';
      const isWarning = warn.severity === 'warning';
      const isFavorable = warn.severity === 'favorable';

      const borderClass = isCritical 
        ? 'border-l-4 border-l-rose-500 bg-rose-950/30' 
        : isWarning 
        ? 'border-l-4 border-l-amber-500 bg-amber-950/30' 
        : isFavorable 
        ? 'border-l-4 border-l-emerald-500 bg-emerald-950/30' 
        : 'border-l-4 border-l-cyan-500 bg-cyan-950/30';

      const badgeColor = isCritical 
        ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30' 
        : isWarning 
        ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' 
        : isFavorable 
        ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' 
        : 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30';

      const icon = isCritical ? '🚨' : isWarning ? '⚠️' : isFavorable ? '✅' : 'ℹ️';

      return `
        <div class="glass-panel rounded-xl p-3.5 ${borderClass} border border-white/10 shadow-xs">
          <div class="flex items-center justify-between mb-1">
            <h4 class="text-xs sm:text-sm font-bold text-white flex items-center gap-1.5">
              <span>${icon}</span> ${warn.title}
            </h4>
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${badgeColor}">
              ${warn.severity}
            </span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed font-normal">
            ${warn.description}
          </p>
        </div>
      `;
    }).join('');
  }

  // 6. Farm Dosage & Seed Calculator
  function recalculateFarmDosage() {
    if (!calcAcresInput) return;
    const acres = parseFloat(calcAcresInput.value) || 1;

    let seedPerAcre = 40; // kg
    let ureaPerAcre = 45; // kg
    let waterPerAcre = 500; // m3

    if (currentCrop === 'Rice') { seedPerAcre = 20; ureaPerAcre = 60; waterPerAcre = 1200; }
    else if (currentCrop === 'Maize') { seedPerAcre = 8; ureaPerAcre = 50; waterPerAcre = 450; }
    else if (currentCrop === 'Cotton') { seedPerAcre = 3; ureaPerAcre = 40; waterPerAcre = 600; }
    else if (currentCrop === 'Sugarcane') { seedPerAcre = 3000; ureaPerAcre = 100; waterPerAcre = 1800; }

    if (calcSeedOut) calcSeedOut.textContent = `${(acres * seedPerAcre).toLocaleString()} ${currentCrop === 'Sugarcane' ? 'setts' : 'kg'}`;
    if (calcUreaOut) calcUreaOut.textContent = `${(acres * ureaPerAcre).toFixed(1)} kg`;
    if (calcWaterOut) calcWaterOut.textContent = `${(acres * waterPerAcre).toLocaleString()} m³`;
  }

  if (calcAcresInput) {
    calcAcresInput.addEventListener('input', recalculateFarmDosage);
  }

  // 7. Location Search Autocomplete & Events
  if (locationInput) {
    locationInput.addEventListener('input', () => {
      const val = locationInput.value.trim();
      if (searchDebounce) clearTimeout(searchDebounce);
      if (val.length < 2) {
        if (searchDropdown) searchDropdown.classList.add('hidden');
        return;
      }
      searchDebounce = setTimeout(async () => {
        try {
          const res = await fetch(`/api/search?q=${encodeURIComponent(val)}`);
          if (!res.ok) return;
          const data = await res.json();
          renderFarmerSearchResults(Array.isArray(data) ? data : (data.value || []));
        } catch (e) {
          console.error(e);
        }
      }, 250);
    });

    locationInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const val = locationInput.value.trim();
        if (val) {
          currentLocation = val;
          localStorage.setItem('mausam_farmer_location', currentLocation);
          if (searchDropdown) searchDropdown.classList.add('hidden');
          loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
        }
      }
    });
  }

  function renderFarmerSearchResults(results: any[]) {
    if (!searchDropdown) return;
    if (results.length === 0) {
      searchDropdown.innerHTML = '<div class="px-4 py-3 text-xs text-slate-400">No matching farm location</div>';
      searchDropdown.classList.remove('hidden');
      return;
    }

    searchDropdown.innerHTML = results.slice(0, 6).map(loc => `
      <div class="farmer-search-item px-4 py-2.5 text-xs cursor-pointer hover:bg-slate-800/80 border-b border-white/5 last:border-b-0 transition-colors"
           data-name="${loc.name}"
           data-display="${loc.display || loc.name}">
        <div class="font-bold text-white">${loc.name}</div>
        <div class="text-[11px] text-slate-400">${loc.region ? loc.region + ', ' : ''}${loc.country}</div>
      </div>
    `).join('');

    searchDropdown.classList.remove('hidden');

    searchDropdown.querySelectorAll('.farmer-search-item').forEach(item => {
      item.addEventListener('click', () => {
        const name = item.getAttribute('data-name') || 'Greater Noida';
        const display = item.getAttribute('data-display') || name;
        currentLocation = name;
        if (locationInput) locationInput.value = display;
        localStorage.setItem('mausam_farmer_location', currentLocation);
        searchDropdown.classList.add('hidden');
        loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
      });
    });
  }

  document.addEventListener('click', (e) => {
    if (searchDropdown && locationInput && !searchDropdown.contains(e.target as Node) && !locationInput.contains(e.target as Node)) {
      searchDropdown.classList.add('hidden');
    }
  });

  if (fetchBtn) {
    fetchBtn.addEventListener('click', () => {
      if (locationInput) {
        const val = locationInput.value.trim();
        if (val) currentLocation = val;
      }
      localStorage.setItem('mausam_farmer_location', currentLocation);
      loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
    });
  }

  if (errorRetryBtn) {
    errorRetryBtn.addEventListener('click', () => {
      loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
    });
  }

  // GPS Current Location
  if (gpsBtn) {
    gpsBtn.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation not supported.');
        return;
      }
      const prevText = gpsBtn.innerHTML;
      gpsBtn.innerHTML = `<span>Locating...</span>`;
      gpsBtn.setAttribute('disabled', 'true');

      navigator.geolocation.getCurrentPosition(
        async (position) => {
          const lat = position.coords.latitude;
          const lon = position.coords.longitude;
          const coords = `${lat},${lon}`;
          try {
            const resp = await fetch(`/api/weather?city=current_location&q=${encodeURIComponent(coords)}`);
            if (!resp.ok) throw new Error('GPS fetch error');
            const data = await resp.json();
            const displayName = data.location?.name ? `${data.location.name}` : coords;
            currentLocation = displayName;
            if (locationInput) locationInput.value = data.location?.name ? `${data.location.name}, ${data.location.country}` : coords;
            localStorage.setItem('mausam_farmer_location', currentLocation);
            loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
          } catch (e) {
            currentLocation = coords;
            if (locationInput) locationInput.value = coords;
            loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
          } finally {
            gpsBtn.innerHTML = prevText;
            gpsBtn.removeAttribute('disabled');
          }
        },
        () => {
          gpsBtn.innerHTML = prevText;
          gpsBtn.removeAttribute('disabled');
          alert('Unable to access device GPS.');
        },
        { enableHighAccuracy: false, timeout: 8000 }
      );
    });
  }

  function setLoadingState(isLoading: boolean) {
    if (fetchBtn) {
      if (isLoading) {
        fetchBtn.classList.add('opacity-75', 'pointer-events-none');
        if (fetchSpinner) fetchSpinner.classList.remove('hidden');
        if (fetchArrow) fetchArrow.classList.add('hidden');
        if (fetchBtnText) fetchBtnText.textContent = 'Analyzing...';
      } else {
        fetchBtn.classList.remove('opacity-75', 'pointer-events-none');
        if (fetchSpinner) fetchSpinner.classList.add('hidden');
        if (fetchArrow) fetchArrow.classList.remove('hidden');
        if (fetchBtnText) fetchBtnText.textContent = 'Generate Advisory';
      }
    }
  }

  function showError(msg: string) {
    if (errorBox) {
      if (errorMsg) errorMsg.textContent = msg;
      errorBox.classList.remove('hidden');
    }
  }

  function hideError() {
    if (errorBox) errorBox.classList.add('hidden');
  }

  // Listen to external state sync
  window.addEventListener('mausam-profile-setting-changed', (e: any) => {
    if (e.detail?.personaId === 'farmer') {
      const settings = e.detail.allSettings || StorageService.getProfileCustomSettings('farmer');
      let changed = false;
      if (settings.target_crop && settings.target_crop !== currentCrop) {
        updateCropSelection(settings.target_crop, false);
        changed = true;
      }
      if (settings.growth_stage && settings.growth_stage !== currentStage) {
        updateStageSelection(settings.growth_stage, false);
        changed = true;
      }
      if (changed) {
        loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
      }
    }
  });

  window.addEventListener('mausam-state-synced', (e: any) => {
    if (e.detail?.personaId === 'farmer') {
      const settings = e.detail.allSettings || StorageService.getProfileCustomSettings('farmer');
      let changed = false;
      if (settings.target_crop && settings.target_crop !== currentCrop) {
        updateCropSelection(settings.target_crop, false);
        changed = true;
      }
      if (settings.growth_stage && settings.growth_stage !== currentStage) {
        updateStageSelection(settings.growth_stage, false);
        changed = true;
      }
      if (changed) {
        loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
      }
    }
  });

  // Network reactivity
  window.addEventListener('online', () => {
    loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
  });
  window.addEventListener('offline', () => {
    loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
  });
  window.addEventListener('mausam-network-status-changed', () => {
    loadFarmerAdvisory(currentCrop, currentStage, currentLocation);
  });

  // Initial Boot
  updateCropSelection(currentCrop, false);
  updateStageSelection(currentStage, true);
</script>
