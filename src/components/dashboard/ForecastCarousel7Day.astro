---
// src/components/dashboard/ForecastCarousel7Day.astro
// 7-Day Interactive Forecast Horizon with horizontal scrolling & day inspection
---

<div class="w-full relative mb-8" id="forecast-carousel-section">
  <!-- Section Header -->
  <div class="flex items-center justify-between mb-4 px-1">
    <div class="flex items-center gap-2">
      <span class="text-lg">📅</span>
      <div>
        <h3 class="text-sm sm:text-base font-bold text-white tracking-apple-tight flex items-center gap-2">
          7-Day Interactive Forecast Horizon
        </h3>
        <p class="text-xs text-slate-400 font-light mt-0.5">
          Select any day to inspect its hourly temperature curve and environmental metrics
        </p>
      </div>
    </div>

    <!-- Carousel Nav Controls -->
    <div class="flex items-center gap-1.5">
      <button
        type="button"
        id="forecast-carousel-prev"
        class="w-8 h-8 rounded-full bg-slate-900/80 border border-white/10 hover:border-white/20 text-slate-300 hover:text-white flex items-center justify-center transition-all active-scale cursor-pointer shadow-sm"
        aria-label="Previous Days"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button
        type="button"
        id="forecast-carousel-next"
        class="w-8 h-8 rounded-full bg-slate-900/80 border border-white/10 hover:border-white/20 text-slate-300 hover:text-white flex items-center justify-center transition-all active-scale cursor-pointer shadow-sm"
        aria-label="Next Days"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Horizontal Scroll Container -->
  <div
    id="forecast-days-container"
    class="flex items-stretch gap-3 overflow-x-auto pb-3 pt-1 scroll-smooth no-scrollbar"
    tabindex="0"
    role="region"
    aria-label="7-Day Forecast Horizon"
  >
    <div class="text-xs text-slate-400 p-4 animate-pulse">Loading 7-day meteorological forecast...</div>
  </div>
</div>

<script>
  const forecastDaysContainer = document.getElementById('forecast-days-container');
  const prevBtn = document.getElementById('forecast-carousel-prev');
  const nextBtn = document.getElementById('forecast-carousel-next');

  let currentDaysData: any[] = [];
  let selectedIndex = 0;

  function renderForecastDays(days: any[]) {
    if (!forecastDaysContainer) return;
    currentDaysData = days;
    forecastDaysContainer.innerHTML = '';

    days.forEach((day, idx) => {
      const isSelected = idx === selectedIndex;
      const card = document.createElement('button');
      card.type = 'button';
      card.className = `forecast-day-card shrink-0 w-[140px] sm:w-[155px] p-3.5 sm:p-4 rounded-2xl border text-left transition-all duration-200 active-scale cursor-pointer relative overflow-hidden flex flex-col justify-between ${
        isSelected
          ? 'bg-gradient-to-b from-slate-900/95 to-slate-950/95 border-cyan-400/60 ring-1 ring-cyan-400/40 shadow-glow-cyan'
          : 'bg-slate-900/60 border-white/10 hover:border-white/20 hover:bg-slate-900/90'
      }`;
      card.setAttribute('data-day-index', String(idx));

      let iconEmoji = '🌤️';
      if (day.icon === 'sunny') iconEmoji = '☀️';
      else if (day.icon === 'rainy') iconEmoji = '🌧️';
      else if (day.icon === 'cloudy') iconEmoji = '⛅';
      else if (day.icon === 'stormy') iconEmoji = '⛈️';
      else if (day.icon === 'moon') iconEmoji = '🌙';

      card.innerHTML = `
        <div class="flex items-center justify-between mb-2">
          <span class="font-bold text-xs ${isSelected ? 'text-cyan-300' : 'text-slate-200'}">${day.label}</span>
          ${day.isToday ? '<span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-400/30">TODAY</span>' : ''}
          ${!day.isToday && day.rain_chance_pct > 30 ? `<span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300">💧 ${day.rain_chance_pct}%</span>` : ''}
        </div>

        <div class="flex items-center gap-2 my-2">
          <span class="text-2xl">${iconEmoji}</span>
          <div class="flex flex-col">
            <span class="text-base font-bold text-white leading-none">${day.temp_max_c}°</span>
            <span class="text-[11px] text-slate-400 font-medium">${day.temp_min_c}°</span>
          </div>
        </div>

        <div class="text-[11px] text-slate-300 truncate font-light mt-1">
          ${day.condition}
        </div>
      `;

      card.addEventListener('click', () => {
        selectedIndex = idx;
        renderForecastDays(currentDaysData);
        window.dispatchEvent(new CustomEvent('mausam-forecast-day-selected', {
          detail: { dayIndex: idx, dayData: day }
        }));
      });

      forecastDaysContainer.appendChild(card);
    });
  }

  prevBtn?.addEventListener('click', () => {
    forecastDaysContainer?.scrollBy({ left: -220, behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    forecastDaysContainer?.scrollBy({ left: 220, behavior: 'smooth' });
  });

  window.addEventListener('mausam-weather-updated', (e: any) => {
    if (e.detail?.forecast7Day && Array.isArray(e.detail.forecast7Day)) {
      selectedIndex = 0;
      renderForecastDays(e.detail.forecast7Day);
    }
  });
</script>
