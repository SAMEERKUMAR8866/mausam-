---
// src/components/dashboard/ForecastCarousel7Day.astro
// 7-Day Interactive Forecast Horizon with touch swipe & day inspection
---

<div class="w-full relative mb-8" id="forecast-carousel-section">
  <!-- Section Header -->
  <div class="flex items-center justify-between mb-3.5 px-1">
    <div class="flex items-center gap-2">
      <span class="text-base sm:text-lg">📅</span>
      <div>
        <h3 class="text-base sm:text-lg font-bold text-white tracking-apple-tight flex items-center gap-2">
          <span class="md:hidden" data-i18n="forecastHorizon">7-Day Forecast</span>
          <span class="hidden md:inline" data-i18n="forecastHorizon">7-Day Interactive Forecast Horizon</span>
        </h3>
        <p class="hidden md:block text-xs text-slate-400 font-light mt-0.5" data-i18n="forecastHorizonSub">
          Select any day to inspect its hourly temperature curve and environmental metrics
        </p>
      </div>
    </div>

    <!-- Carousel Nav Controls -->
    <div class="flex items-center gap-1.5">
      <button
        type="button"
        id="forecast-carousel-prev"
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-slate-900/80 border border-white/10 hover:border-white/20 text-slate-300 hover:text-white flex items-center justify-center transition-all active-scale cursor-pointer shadow-sm"
        aria-label="Previous Days"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button
        type="button"
        id="forecast-carousel-next"
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-slate-900/80 border border-white/10 hover:border-white/20 text-slate-300 hover:text-white flex items-center justify-center transition-all active-scale cursor-pointer shadow-sm"
        aria-label="Next Days"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Horizontal Swipeable Scroll Container -->
  <div
    id="forecast-days-container"
    class="flex items-stretch gap-2.5 sm:gap-3 overflow-x-auto pb-3 pt-1 scroll-smooth snap-x snap-mandatory no-scrollbar"
    tabindex="0"
    role="region"
    aria-label="7-Day Forecast Horizon"
  >
    <div class="text-xs text-slate-400 p-4 animate-pulse">Loading 7-day meteorological forecast...</div>
  </div>

  <!-- Mobile Swipe Helper Indicator -->
  <div class="flex md:hidden items-center justify-center gap-1.5 pt-1 text-[10px] text-slate-500 font-medium">
    <span>👈</span>
    <span data-i18n="swipe7Days">Swipe horizontally for all 7 days</span>
    <span>👉</span>
  </div>
</div>

<script>
  import { I18nService } from '../../services/i18n.service';

  const forecastDaysContainer = document.getElementById('forecast-days-container');
  const prevBtn = document.getElementById('forecast-carousel-prev');
  const nextBtn = document.getElementById('forecast-carousel-next');

  let currentDaysData: any[] = [];
  let selectedIndex = 0;

  function renderForecastDays(days: any[]) {
    if (!forecastDaysContainer) return;
    currentDaysData = days;
    forecastDaysContainer.innerHTML = '';

    const todayText = I18nService.t('today', 'TODAY').toUpperCase();

    days.forEach((day, idx) => {
      const isSelected = idx === selectedIndex;
      const card = document.createElement('button');
      card.type = 'button';
      card.className = `forecast-day-card spotlight-card framer-spring-hover framer-spring-press shrink-0 snap-start w-[130px] sm:w-[160px] p-3 sm:p-4 rounded-2xl border text-left transition-all duration-300 cursor-pointer relative overflow-hidden flex flex-col justify-between ${
        isSelected
          ? 'bg-gradient-to-b from-slate-900/95 via-slate-900/90 to-slate-950/95 border-cyan-400/80 shadow-[0_0_25px_rgba(6,182,212,0.35)] border-t-cyan-300 ring-2 ring-cyan-400/30 scale-[1.02]'
          : 'bg-slate-900/50 backdrop-blur-xl border-white/10 hover:border-white/25 hover:bg-slate-900/80 border-t-white/15'
      }`;
      card.setAttribute('data-day-index', String(idx));

      let iconEmoji = '🌤️';
      if (day.icon === 'sunny') iconEmoji = '☀️';
      else if (day.icon === 'rainy') iconEmoji = '🌧️';
      else if (day.icon === 'cloudy') iconEmoji = '⛅';
      else if (day.icon === 'stormy') iconEmoji = '⛈️';
      else if (day.icon === 'moon') iconEmoji = '🌙';

      const dayLabel = day.isToday ? I18nService.t('today', day.label) : I18nService.t(day.label, day.label);
      const conditionText = I18nService.translateWeather(day.condition);

      card.innerHTML = `
        <div class="flex items-center justify-between mb-1.5">
          <span class="font-bold text-xs tracking-apple-tight ${isSelected ? 'text-cyan-300 font-extrabold' : 'text-slate-200'}">${dayLabel}</span>
          ${day.isToday ? `<span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-400/30">${todayText}</span>` : ''}
          ${!day.isToday && day.rain_chance_pct > 30 ? `<span class="text-[9px] font-semibold px-1.5 py-0.5 rounded-full bg-blue-500/20 text-blue-300">💧 ${day.rain_chance_pct}%</span>` : ''}
        </div>

        <div class="flex items-center gap-2.5 my-2">
          <span class="text-2xl sm:text-3xl drop-shadow-sm">${iconEmoji}</span>
          <div class="flex flex-col">
            <span class="text-base sm:text-lg font-black text-white leading-none">${day.temp_max_c}°</span>
            <span class="text-[11px] text-slate-400 font-medium mt-0.5">${day.temp_min_c}°</span>
          </div>
        </div>

        <!-- 21st.dev Mini Temperature Range Sparkline Bar -->
        <div class="w-full bg-slate-950/80 rounded-full h-1 overflow-hidden my-1 relative border border-white/5">
          <div class="spectrum-bar-thermal h-full rounded-full w-full opacity-80"></div>
        </div>

        <div class="text-[11px] text-slate-300 truncate font-light mt-0.5">
          ${conditionText}
        </div>
      `;

      card.addEventListener('click', () => {
        selectedIndex = idx;
        renderForecastDays(currentDaysData);
        window.dispatchEvent(new CustomEvent('mausam-forecast-day-selected', {
          detail: { dayIndex: idx, dayData: day }
        }));
      });

      forecastDaysContainer.appendChild(card);
    });
  }

  prevBtn?.addEventListener('click', () => {
    forecastDaysContainer?.scrollBy({ left: -220, behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    forecastDaysContainer?.scrollBy({ left: 220, behavior: 'smooth' });
  });

  window.addEventListener('mausam-weather-updated', (e: any) => {
    if (e.detail?.forecast7Day && Array.isArray(e.detail.forecast7Day)) {
      selectedIndex = 0;
      renderForecastDays(e.detail.forecast7Day);
    }
  });

  window.addEventListener('mausam-language-changed', () => {
    const root = document.getElementById('forecast-carousel-section');
    if (root) I18nService.translateDocument(root);
    if (currentDaysData.length > 0) {
      renderForecastDays(currentDaysData);
    }
  });
</script>

