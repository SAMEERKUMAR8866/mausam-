---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mausam - Personalized Weather Dashboard",
  description = "A personalized weather homepage experience for health, fitness, travel, farming, commuting, and planning."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-canvas text-ink antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons & Web Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Google Fonts for typography system fallback (SF Pro equivalent) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-full flex flex-col font-body bg-canvas select-none selection:bg-primary/20">
    <slot />
  </body>
</html>